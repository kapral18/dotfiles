    subgraph GH["scripts/pickers/github/ — GitHub picker"]
        GHROUTER["gh_dashboard.sh.tmpl router<br/>(default mode from .isWork)"]:::sh
        GHP["gh_picker.sh (fzf TUI; --mode work|home --scope all|focus|explore)<br/>stale-while-revalidate: start→cache, bg fetch→POST reload($FZF_PORT)<br/>--id-nth=2,3,4 keeps multi marks across reload-sync"]:::sh
        GHITEMS["gh_items.sh → lib/gh_items_main.py (rows from gh + YAML;<br/>GraphQL review-request actors separate direct-user and selected-team queues)<br/>fetch-lock publication grace: a waiter never reaps an owner between mkdir and pid publish"]:::py
        GHCFG[["readonly_gh-picker-{work,home}.yml (gh-dash-style sections)"]]:::data
        GHUI["lib/gh_dashboard_ui.py + gh_* Python helpers"]:::py
        GHPREV["gh_preview.sh + lib/gh_preview_warm.sh"]:::sh
        GHACT["gh_action.sh · gh_comment.sh · gh_create.sh (lib/gh_create.py)<br/>gh_picker_palette.sh · gh_row_loader.sh (token-gated, EXIT-joined spinner frames:<br/>joined spinner posts precede authoritative reloads) · gh_batch_worktree.sh +<br/>gh_batch_branch_prompt.txt (nohup-detached cross-batch lock + serialized creates;<br/>per-item/total timeout + publication/cleanup-safe ledger reap with pid-reuse-safe kills;<br/>issue scratch + DeepSeek max agent sidecar; captured outer-socket tmux sessions)<br/>· gh_popup.sh · keyhelp.sh"]:::sh
        GHBIND["lib/ fzf-binding shims (.sh):<br/>collapse · ctrl_t · enter · jump · mark_subtree · palette<br/>scope · sort · toggle (+ collapse.py, mark_subtree.py)"]:::sh
        GHROUTER --> GHP --> GHITEMS --> GHCFG
        GHP --> GHPREV & GHACT & GHUI & GHBIND
    end

    subgraph SE["scripts/pickers/session/ — Session picker"]
        SESS["pick_session.sh + popup.sh + preview.sh + keyhelp.sh<br/>preview classifies agent/idle/editor/busy panes; Antigravity process = agy"]:::sh
        SIDX["index.sh / index_update.sh / index_update_hook.sh<br/>ordered_cache_update.sh → lib/index_main.py + frecency.py<br/>tmux enumeration fails closed; raced ordered snapshots are discarded<br/>quick publish merges and refuses to drop cached worktree/dir rows<br/>create/rename hooks: --force --quick-only --defer-if-busy (no full-scan pre-empt)<br/>GH PR/issue metadata + PR-review color tags; session rows hydrate after discovery<br/>merged/closed PR rows dim; gh lookup tri-state (success/absent/failure) keeps last-known badge on transient failure<br/>legacy PR-author cache refresh"]:::py
        SFILT["filter.sh → lib/filter_main.py + pick_session_grouping.py<br/>dedup keys session rows by (path, name): same-path sessions stay distinct;<br/>a session still shadows worktree/dir rows at its path"]:::py
        SITEMS["items.sh / items_hide_selected.sh / open_items.sh<br/>→ lib/items_full_rehydrate · items_light_rehydrate · items_hide_selected_main<br/>rehydration preserves cache on failed tmux enumeration<br/>rehydrates cached PR-review row color<br/>open_items ordered.current meta: portable GNU/BSD stat (gnubin-safe)"]:::py
        SLIVE["live_refresh.sh · fzf_reload.sh · on_start.sh<br/>on_session_switch.sh · lib/sort_toggle_daemon.py<br/>empty query keeps grouped order; settled query gets one off-screen tiered relevance reload<br/>starts PR-author metadata refresh immediately"]:::sh
        SCACHE["lib/cache_prune_paths.py · cache_prune_sessions.py<br/>publish_cache_filter.py · bag_preserve_non_wt.py<br/>fixup_current_marker.py · session_naming.sh (empty-column-safe TSV parsing)"]:::py
        SACT["action_create_worktree · action_kill_sessions · action_only_cycle<br/>action_open_gh · action_remove_worktrees (preflight + inline fzf force confirm; row-aligned session names) · action_send_command<br/>remove_all_worktrees (deletes only HOME/scan-root descendants; keeps sibling git roots)<br/>remove_plain_dir (kills the caller-named session)"]:::sh
        SESS --> SIDX --> SFILT --> SITEMS
        SESS --> SLIVE & SCACHE & SACT
    end

    subgraph PLIB["scripts/pickers/lib/ — cross-picker handoff"]
        HO["handoff_namespace.py · handoff_to_{gh,sessions}.sh<br/>dispatch_async.sh · snapshot_fzf_selection.sh<br/>pin_{gh,session}_first.sh"]:::py
    end
    GH <--> PLIB
    SE <--> PLIB

