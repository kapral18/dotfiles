%% ============================================================================
%% 12-ai-tool-configs.mmd — Every per-tool AI config file in home/.
%% Pattern: source carries .work + .personal variants; a 07-merge-* hook picks
%% by isWork and merges generated MCP blocks into the live config. Models are set
%% directly in each harness file; there is no shared model registry.
%% ============================================================================
flowchart TB
    classDef reg fill:#1d3b53,stroke:#7fb3d5,color:#eaf2f8;
    classDef claude fill:#3a2b1b,stroke:#ffb74d,color:#fff3e0;
    classDef codex fill:#2c2c34,stroke:#b39ddb,color:#f3e5f5;
    classDef gem fill:#1b3a2b,stroke:#81c784,color:#e8f5e9;
    classDef oc fill:#3a1b2b,stroke:#f48fb1,color:#fce4ec;
    classDef omp fill:#233a22,stroke:#a5d66d,color:#f1f8e9;

    LAUNCH["Launchers: ,claude-openrouter · ,codex-openrouter (OpenRouter, xiaomi/mimo-v2.6-pro@preset/effort-high)<br/>,claude-llama-cpp · ,codex-llama-cpp · ,opencode-llama-cpp (local router lease) · ,codex (local catalog injection)<br/>,q execs Pi for OpenRouter deepseek/deepseek-v4.1-flash with a short system prompt; skips APPEND_SYSTEM/skills/context/extensions"]:::reg

    subgraph CLAUDE["Claude Code (dot_claude/)"]
        CLD["symlink_CLAUDE.md → ~/.claude/CLAUDE.md → ~/AGENTS.md<br/>settings.work.json · settings.personal.json (claude-sonnet-5-5 high; spawn depth 1; autoCompactWindow 400000; auto-memory off; no hooks)<br/>settings.llama-cpp*.json.tmpl · symlink_skills · exact_agents/k-agent-reviewer.md.tmpl"]:::claude
    end

    subgraph CODEX["Codex (dot_codex/)"]
        CDX["private_config.work.toml (workspace-write + on-request/auto_review; writable roots incl. chezmoi, ai-kb, agent-handoffs, ~/bin, ~/lib)<br/>private_config.personal.toml (never + danger-full-access)<br/>both: gpt-6.1-sol high · auto_recap off · memories off · symlink_AGENTS.md · readonly_llama-cpp-model-catalog.json.tmpl"]:::codex
    end

    subgraph GEMINI["Antigravity / agy (dot_gemini/)"]
        GMN["config/symlink_AGENTS.md → ~/AGENTS.md · config/symlink_skills → ~/.agents/skills<br/>private_antigravity-cli/readonly_settings.policy.json (Gemini 3.8 Flash High) → policy-merged settings.json<br/>generated config/mcp_config.json"]:::gem
    end

    subgraph OPENCODE["OpenCode (dot_config/opencode/)"]
        OPC["readonly_opencode.work.jsonc · readonly_opencode.personal.jsonc (OpenRouter preset models; subagent_depth 1)<br/>symlink_AGENTS.md · symlink_skills"]:::oc
    end

    subgraph PI["Pi agent (dot_pi/agent/)"]
        PIA["readonly_settings.{work,personal}.json (openai-codex/gpt-6.1-sol high; compaction 80000 recent; pi-subagents builtins off)<br/>readonly_models.json · readonly_models.personal.json (openrouter + llama-cpp providers)<br/>readonly_APPEND_SYSTEM.md · symlink_AGENTS.md<br/>exact_agents/k-agent-scout.md · exact_agents/k-agent-reviewer.md.tmpl<br/>exact_extensions/: context-mode.ts.tmpl · model-pin.ts · read-supersede.ts · subagent/readonly_config.json"]:::claude
    end

    subgraph OMP["OMP (dot_omp/private_agent/)"]
        OMPA["readonly_config.yml.tmpl (modelRoles openai-codex GPT-6.1 Sol/GPT-6 Luna; advisor, memory, autolearn, recap off;<br/>task.maxRecursionDepth 1; built-in reviewer + security-reviewer disabled)<br/>readonly_models.yml · readonly_APPEND_SYSTEM.md · readonly_RULES.md · symlink_AGENTS.md · symlink_skills<br/>exact_agents/k-agent-reviewer.md.tmpl · extensions/context-mode.ts.tmpl"]:::omp
    end

    GPT_CONTEXT["Pi + OMP context-mode.ts.tmpl → ~/lib/shared/context_mode.ts<br/>/context-mode short|long|status; GPT defaults short"]:::reg
    PIA & OMPA --> GPT_CONTEXT

    subgraph OTHER["Other terminal assistants"]
        TUI["tuicr: dot_config/tuicr/readonly_config.toml"]:::oc
        LGTM["lgtm: dot_config/lgtm/readonly_config.toml"]:::oc
        CRUSH["Crush: dot_config/crush/readonly_crushrc<br/>global-context-path $HOME/AGENTS.md · model large openrouter/z-ai/glm-5.3-flash high"]:::oc
    end

    REG[[".chezmoidata/mcp_servers.yaml (see 11)"]]:::reg
    REG --> CLAUDE & CODEX & GEMINI & OPENCODE & PI & OMP
    LAUNCH --> CLAUDE & CODEX & OPENCODE & PI
    PROMPT[[".chezmoitemplates/reviewer-prompt.md<br/>shared k-agent-reviewer body"]]:::reg
    PROMPT --> CLAUDE & PI & OMP
    LEDGER[("~/.local/state/chezmoi/generated_artifacts.v1.json<br/>10 AI artifacts · source/transform/profile/ownership/consumer<br/>,doctor ai = static; --live = deduped local probes")]:::oc
    CLAUDE & CODEX & GEMINI & OPENCODE & PI & OMP --> LEDGER
