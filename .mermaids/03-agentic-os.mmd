        OMP["OMP: dot_omp/private_agent/readonly_config.yml.tmpl<br/>foreground Bash/Eval default + native-yield leaf async/hub/task guard<br/>one profile-independent modelRoles block: Fable 5.1:high primaries (default/vision/slow/plan, T1); task Opus 5:high (T2 implement); smol Sonnet 5:high (T3 mechanical/memory); tiny Sonnet 5:medium; commit Sonnet 5:medium; advisor openai-codex gpt-6-astra:high (refute, cross_family)<br/>+ generated ~/.omp/agent/mcp.json token bridges"]:::exec
        COPILOT["Copilot CLI: private_dot_copilot/* (settings + gates + review agents;<br/>MCP stdio-only, OAuth http unusable)"]:::exec
        TUICR["tuicr: dot_config/tuicr/readonly_config.toml"]:::exec
        LGTM["lgtm: dot_config/lgtm/readonly_config.toml"]:::exec
        LOCAL["llama.cpp (local, opt-in)"]:::exec
    end

