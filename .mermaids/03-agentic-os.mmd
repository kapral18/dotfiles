%% ============================================================================
%% 03-agentic-os.mmd — AI layer: instructions + skills + subagents + on-demand memory.
%% Shared instructions, MCP registry, per-tool config generation.
%% Skills/subagent file-level detail → 03b. Per-tool config files → 12.
%% ============================================================================
flowchart TB
    classDef gov fill:#3a1b2b,stroke:#f48fb1,color:#fce4ec,stroke-width:2px;
    classDef ctx fill:#1b3a2b,stroke:#81c784,color:#e8f5e9;
    classDef exec fill:#3a2b1b,stroke:#ffb74d,color:#fff3e0;
    classDef data fill:#1d3b53,stroke:#7fb3d5,color:#eaf2f8;

    subgraph GOV["1 · Instructions (chezmoi-managed, loaded every session)"]
        AG["readonly_AGENTS.md → ~/AGENTS.md (~6 KB, 8 sections)<br/>intent/scope · evidence · doing the work · subagents · side effects · tools · memory/handoffs · response shape"]:::gov
        CL["readonly_CLAUDE.md → ~/CLAUDE.md (@AGENTS.md import)<br/>dot_claude/symlink_CLAUDE.md → ~/.claude/CLAUDE.md → ~/AGENTS.md"]:::gov
        LINKS["symlink_AGENTS.md in ~/.pi/agent · ~/.omp/agent · ~/.codex · ~/.config/opencode · ~/.gemini/config<br/>crushrc global-context-path → ~/AGENTS.md"]:::gov
        SK["home/exact_dot_agents/exact_skills/ → ~/.agents/skills/<br/>intent-routed skills, loaded on demand (see 03b)"]:::gov
        PR["repo AGENTS.md: chezmoi source of truth, make fmt / make check, docs hygiene, k- skill naming<br/>docs/topics/workflow/dotfiles-recipes.md for package, shell/helper and command work"]:::gov
        AG --> CL & LINKS
        AG -->|Use when… loads the skill| SK
        AG --> PR
    end

    subgraph CTX["2 · Context (single source of truth)"]
        REG[[".chezmoidata/mcp_servers.yaml<br/>generic registry + work/domain servers"]]:::data
        GEN["scripts/: mcp_registry.py · generate_mcp_configs.py<br/>resolve $(pass …) · filter by tool + work_only/isWork"]:::ctx
        REG --> GEN
    end

    subgraph EXECL["3 · Execution (per-tool, .work/.personal merged at apply; models set in each file)"]
        CLAUDE["Claude Code: dot_claude/settings.{work,personal}.json + settings.llama-cpp*.json.tmpl<br/>exact_agents/k-agent-reviewer · built-in Explore · spawn depth 1"]:::exec
        PI["Pi: dot_pi/agent/* · pi-subagents (builtins off)<br/>k-agent-scout + k-agent-reviewer · context-mode · model-pin · read-supersede"]:::exec
        OMP["OMP: dot_omp/private_agent/readonly_config.yml.tmpl<br/>native scout + k-agent-reviewer · advisor/memory off · maxRecursionDepth 1"]:::exec
        CODEX["Codex: dot_codex/private_config.{work,personal}.toml + ,codex wrapper"]:::exec
        OPENCODE["OpenCode: dot_config/opencode/*.jsonc"]:::exec
        GEMINI["Antigravity: dot_gemini/ symlinks + generated mcp_config.json + policy-merged settings"]:::exec
        TUICR["tuicr / lgtm review TUIs"]:::exec
        LOCAL["llama.cpp (local, opt-in)"]:::exec
    end

    GEN -->|07-generate-mcp-configs + 07-merge-* hooks| EXECL
    SK -. symlinked or natively discovered by .-> CLAUDE & PI & OMP & CODEX & OPENCODE & GEMINI

    subgraph MEM["4 · On-demand memory (no hooks, no automatic recall)"]
        KB[(",ai-kb → ~/.local/share/ai-kb<br/>search / remember / curate")]:::data
        HO[(",handoff → ~/.local/share/agent-handoffs/&lt;repo&gt;/&lt;topic&gt;.md<br/>save / show / list; k-handoff skill")]:::data
    end
    SK <-->|k-ai-kb| KB
    SK <-->|k-handoff| HO

    AG --> INLINE["Inline by default: read callers → change → checks once on the finished change"]
    INLINE -->|user asks for review| REV["k-review verify mode: one k-agent-reviewer run → check findings → fix once → re-check changed lines → stop"]
