    AG --> SCOPE["Scope"] --> UNDERSTAND["Understand · strong research"] --> PRODUCE["Produce · implementation/mechanical"] --> VERIFY["Verify per snapshot · strong judgment + shared checks"] --> DELIVER["Deliver · pass/fail/blocked"]
