%% ============================================================================
%% 11-scripts-helpers.mmd — Every file in scripts/ (96). Repo-side Python
%% (stdlib only, no PyYAML) called by chezmoi 07-* hooks + ,bin commands.
%% Grouped by consumer. Shared parsers feed the generators/mergers.
%% ============================================================================
flowchart TB
    classDef shared fill:#1d3b53,stroke:#7fb3d5,color:#eaf2f8;
    classDef mcp fill:#1b3a2b,stroke:#81c784,color:#e8f5e9;
    classDef ai fill:#2c2c34,stroke:#b39ddb,color:#f3e5f5;
    classDef misc fill:#3a1b2b,stroke:#f48fb1,color:#fce4ec;

    subgraph SHARED["Shared parsers / libs"]
        YP["yaml_parser.py (minimal YAML, parse_scalar)"]:::shared
        MD["jsonc_dump.py (JSONC writer)"]:::shared
        CL["chezmoi_lib.sh (thin hook interface; string writes compare desired plus one newline byte-for-byte;<br/>repairs requested modes without rewriting matching content)<br/>managed_config_manifest.py (generic literal checksum ledger)<br/>generated_artifact_ledger.py (generated-artifact ledger; backs ,doctor ai)"]:::shared
        TS["_test_support.py (puts scripts/ on sys.path for direct script tests)<br/>test_runner.py (file-sharded parallel unittest runner for make test / bin/check; not itself a unittest shard)"]:::shared
    end

    subgraph MCPGEN["MCP config generation (hook 07-generate-mcp-configs)"]
        MR["mcp_registry.py (load mcp_servers.yaml, filter;<br/>default shell resolution)"]:::mcp
        GMC["generate_mcp_configs.py (per-tool MCP json)"]:::mcp
        MCM["merge_claude_mcp.py (surgical mcpServers in ~/.claude.json;<br/>malformed live JSON fails before write; missing file bootstraps even with empty registry)<br/>merge_antigravity_mcp.py (declared-over-live MCP with prior-owned retirement)"]:::mcp
        ICT["inject_mcp_into_codex_toml.py (hook 07-merge-codex; runtime table comments preserve ownership)"]:::mcp
        IOJ["inject_mcp_into_opencode_jsonc.py (hook 07-merge-opencode)"]:::mcp
    end
    YP --> MR --> GMC --> MCM & ICT & IOJ

    subgraph RECON["Mixed-ownership config reconciliation"]
        MCS["merge_antigravity_cli_settings.py (declared-over-live;<br/>pins modelProvider+model; strips gcp)"]:::mcp
    end

    subgraph AIKB["AI knowledgebase + embeddings (on demand)"]
        KB["ai_kb.py (markdown + SQLite FTS5 store; deployed as ~/lib/,ai-kb/main.py)"]:::ai
        EMB["embed.py dispatch<br/>embed_runner.py = one-shot embeddings<br/>embed_client.py + embed_worker.py = optional private resident worker"]:::ai
        VEC["vec_runner.py (vector retrieval subprocess)"]:::ai
    end
    KB --> EMB & VEC

    subgraph ORCH["Package ops + validators"]
        RCP["reconcile_custom_packages.py (hook 05-install-custom-packages)"]:::misc
        IZB["install_github_zip_bundle.py (hook 05 zip_opt → ~/.local/opt + PATH wrapper)"]:::misc
        RGP["reconcile_golang_pkgs.py (hook 05-update-golang-pkgs; binary reconcile + state ledger)"]:::misc
        SLC["sync_llama_cpp_models.py (hook 07-sync-llama-cpp-models)"]:::misc
        CHK["check.py (bin/check / make check; convention + one-hop imports + TEST_RULES; make check-full is human-only CHECK_FULL=1)<br/>verify_templates.py · verify_mermaids.py · verify_docs_navigation.py · verify_bin_surface.py · verify_agent_file_sizes.py"]:::misc
        YT["yt_search.py (,youtube-search backend)"]:::misc
    end

    subgraph TESTS["Tests + fixtures"]
        TTOP["top-level tests: test_{ai_kb,check,chezmoi_lib,embed,generate_mcp_configs,generated_artifact_ledger,<br/>inject_mcp_into_codex_toml,inject_mcp_into_opencode_jsonc,mcp_registry,merge_antigravity_cli_settings,merge_antigravity_mcp,<br/>pre_commit,verify_agent_file_sizes,verify_bin_surface,verify_docs_navigation,verify_mermaids,verify_templates,yaml_parser}.py<br/>test_omp_migration.py (OMP install/config/agents/extensions contract)"]:::shared
        IT["scripts/tests/: __init__.py · bin_command_support.py · test_bin_commands.py (compat aggregator) · context_mode.test.ts (shared Pi/OMP selector)<br/>test_{artifact,codex,doctor,format_md,handoff,invariants,q,update,kbn_stack,sem_launcher,install_pnpm_pkgs}.py<br/>test_{llama_cpp_lifecycle,llama_cpp_wrappers,openrouter_wrappers}.py · test_{image_codex,image_local,image_openai,image_openrouter,nano_banana}.py<br/>test_{gh_picker_dispatch_state,gh_picker_lock,gh_picker_review_requests,session_github_cache,tmux_handoff_lifecycle,tmux_handoff_namespace,tmux_pickers}.py<br/>test_{install_github_zip_bundle,plain_session_removal,playwriter_skill_docs,present_pr_template,w_issue,w_remove_detached,wh,worktree_delete_boundaries}.py"]:::shared
        FX["fixtures/: {mcp_servers,mcp_servers_exclude}.yaml · codex_base.toml · golden_codex_personal.toml<br/>golden_mcp_{personal,work}.json · golden_opencode_personal.jsonc · opencode_base.jsonc"]:::shared
    end
    MCPGEN -.verified by golden.-> TESTS
    RECON -.verified by focused tests.-> TESTS
