flowchart TB
    classDef skill fill:#3a1b2b,stroke:#f48fb1,color:#fce4ec;
    classDef ref fill:#1b3a2b,stroke:#81c784,color:#e8f5e9;
    classDef data fill:#1d3b53,stroke:#7fb3d5,color:#eaf2f8;

    ROUTE["~/AGENTS.md + skill descriptions: 'Use when…' → load SKILL.md on demand<br/>references use full deployed paths ~/.agents/skills/k-&lt;name&gt;/…"]

    subgraph CORE["Core workflow skills"]
        S1["k-review/ (modes: local changes · PR review · PR fix · plan review; capped verify mode;<br/>refs: authorship, shared_rules, judging_core + judging_state/change/product, pr_*, review_fixes, review_delivery, live-ui-runtime)<br/>k-light-review · k-pr-fix-loop (one check run, two-attempt stop)"]:::skill
        S2["k-git · k-github (+refs: attachments, pr-create, pr-reviews, pr-comments, sub-issues) · k-worktrees<br/>k-compose-pr · k-compose-issue · k-present-pr · k-communication"]:::skill
        S3["k-spec (+refs: check-strength, packet-template) · k-build · k-diagnosing-bugs · k-interview-me<br/>k-codebase-design · k-code-quality(-react/-tests/-web) · k-walkthrough · k-public-sources · k-prototype"]:::skill
        S1 --> R1["exact_references/*.md"]:::ref
    end

    subgraph IMPROVE["improve-* family"]
        S4["k-improve-branch · k-improve-codebase · k-improve-local · k-improve-targeted"]:::skill
    end

    subgraph TOOLS["Tool-backed skills (wrap a CLI or MCP)"]
        S5["k-buildkite · k-tmux · k-sem · k-knip · k-jscpd · k-artifact · k-ui-capture · k-live-ui-windows · k-playwriter"]:::skill
        S6["k-google-workspace · k-slack · k-letsfg · k-nano-banana · k-omp · k-text-tournament"]:::skill
        S7["k-ai-kb (+ref: cli) · k-handoff"]:::skill
    end

    subgraph KBN["Elastic/Kibana domain overlay + skills"]
        S8["k-elastic-domain (verified overlay; +refs: kibana-live-ui, kibana-live-ui-evidence, kibana-planning-forks, pr-issue templates)<br/>k-elastic-slides · k-kbn-stack · k-kbn-backport · k-kbn-standup<br/>k-kibana-labels-propose · k-kibana-management-ownership · k-kibana-console-monaco"]:::skill
    end

    subgraph META["Meta skills"]
        CLI["k-cli-skills · k-writing-great-skills · k-instruction-boundaries"]:::skill
    end

    ROUTE --> CORE & IMPROVE & TOOLS & KBN & META

    KBDB[("~/.local/share/ai-kb capsules + SQLite FTS/vector index")]:::data
    HODB[("~/.local/share/agent-handoffs/&lt;repo&gt;/&lt;topic&gt;.md")]:::data
    S7 <--> KBDB & HODB

    SUBA["Subagent profiles (see 12): k-agent-reviewer (Claude, Pi, OMP; shared .chezmoitemplates/reviewer-prompt.md) · k-agent-scout (Pi)"]
    S1 -->|verify mode: one reviewer run| SUBA
