#!/usr/bin/env bash

set -euo pipefail

# redtab (private repo kapral18/redtab) is a terminal Reddit reader that reads
# Reddit through a local Redlib container. old.reddit.com sends logged-out
# clients to a login wall, and public Redlib instances serve bot checks.
#
# This hook sorts last (09): it fails while Docker is not running, and chezmoi
# stops at a failed hook, so no other hook may come after it.

if command -v mise >/dev/null 2>&1; then
  export PATH="$HOME/.local/share/mise/shims${PATH:+:${PATH}}"
fi

REDTAB_REPO="kapral18/redtab"
# Pinned by commit: bump it here to ship a new redtab build.
REDTAB_COMMIT="4cc10c500307b521f1f287b7360ba63324322bed"
# Fork image: the official quay.io/redlib/redlib build fails with "Failed to
# create OAuth client" (https://github.com/redlib-org/redlib/issues/485).
# Pinned by digest so a fork update is a reviewed change here.
REDLIB_IMAGE="ghcr.io/silvenga/redlib@sha256:5b7b92744ca153c75bef1f5b6b5ffb6985a230c91019d722a88ec758b15f502d"
REDLIB_CONTAINER="redtab-redlib"
# host:port that redtab reads Redlib from (`redlib_url` in the redtab config).
{{- $redtabConfig := include "dot_config/redtab/readonly_config.toml" | fromToml }}
{{- $redlibUrl := urlParse $redtabConfig.redlib_url }}
{{- /* Fail at render time, before the old container is removed: --publish needs IP:port, and Redlib stays loopback-only. */}}
{{- if ne $redlibUrl.hostname "127.0.0.1" }}{{ fail "redtab redlib_url must use host 127.0.0.1" }}{{ end }}
{{- $redlibPort := $redlibUrl.host | trimPrefix $redlibUrl.hostname | trimPrefix ":" }}
{{- if $redlibPort | regexMatch "^[1-9][0-9]{0,4}$" | not }}{{ fail "redtab redlib_url must include a port from 1 to 65535" }}{{ end }}
{{- if $redlibPort | atoi | lt 65535 }}{{ fail "redtab redlib_url must include a port from 1 to 65535" }}{{ end }}
REDLIB_ADDR={{ $redlibUrl.host | quote }}
BIN_DIR="${HOME}/.local/bin"

for cmd in gh cargo docker; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: redtab install needs '$cmd' in PATH" >&2
    exit 1
  fi
done

if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker is not running; start Docker Desktop and re-run chezmoi apply to install redtab and Redlib" >&2
  exit 1
fi

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

# gh, not git over SSH: the repo is private and gh already holds the token.
gh api "repos/$REDTAB_REPO/tarball/$REDTAB_COMMIT" >"$work_dir/src.tar.gz"
mkdir "$work_dir/src"
tar -xzf "$work_dir/src.tar.gz" -C "$work_dir/src" --strip-components 1

mkdir -p "$BIN_DIR"
cargo build --release --locked --manifest-path "$work_dir/src/Cargo.toml" --target-dir "$work_dir/target"
install -m 0755 "$work_dir/target/release/redtab" "$BIN_DIR/redtab"
echo "redtab built (${REDTAB_COMMIT:0:12})"

docker pull --quiet "$REDLIB_IMAGE" >/dev/null
docker rm --force "$REDLIB_CONTAINER" >/dev/null 2>&1 || true
# --no-healthcheck: the image's check runs `wget`, which the image does not ship,
# so Docker would mark a working container unhealthy.
docker run --detach --name "$REDLIB_CONTAINER" --restart unless-stopped --no-healthcheck \
  --publish "${REDLIB_ADDR}:8080" "$REDLIB_IMAGE" >/dev/null
echo "Redlib running at http://${REDLIB_ADDR} (container $REDLIB_CONTAINER)"
