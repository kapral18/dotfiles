#!/usr/bin/env bash

set -euo pipefail

{{- if eq .isWork true }}
# pi settings desired hash (work): {{ include "dot_pi/agent/readonly_settings.work.json" | sha256sum }}
# pi models desired hash: {{ include "dot_pi/agent/readonly_models.json" | sha256sum }}
{{- else }}
# pi settings desired hash (non-work): {{ include "dot_pi/agent/readonly_settings.personal.json" | sha256sum }}
# pi models desired hash (non-work): {{ include "dot_pi/agent/readonly_models.personal.json" | sha256sum }}
{{- end }}
# chezmoi_lib.sh hash: {{ include "../scripts/chezmoi_lib.sh" | sha256sum }}
# managed_config_manifest.py hash: {{ include "../scripts/managed_config_manifest.py" | sha256sum }}
# generated_artifact_ledger.py hash: {{ include "../scripts/generated_artifact_ledger.py" | sha256sum }}
{{- /* shfmt parses this file as shell, and a parenthesised template call trips its lexer. */}}
{{- $piProfile := includeTemplate "pi-model-profile.partial" . | fromJson }}
{{- $piSession := $piProfile.session }}
# active pi model profile: {{ $piProfile.name }}
# pi profile session hash: {{ $piSession | toJson | sha256sum }}

source_dir="${CHEZMOI_SOURCE_DIR:-{{ .chezmoi.sourceDir }}}"
# shellcheck source=../../../scripts/chezmoi_lib.sh
source "$source_dir/../scripts/chezmoi_lib.sh"

is_work="{{ if eq .isWork true }}true{{ else }}false{{ end }}"
profile="{{ if eq .isWork true }}work{{ else }}personal{{ end }}"
target_dir="$HOME/.pi/agent"

src_settings="$(chezmoi_pick_src "$is_work" "$source_dir" \
  "dot_pi/agent/readonly_settings.work.json" \
  "dot_pi/agent/readonly_settings.personal.json")"

# the source settings json is regenerated from session_models by scripts/generate_session_models.py, which
# is the `default` profile; this apply-time patch re-points the root at the active profile's session row.
# include() does not recursively render .tmpl content, so the substitution happens here, at apply time,
# rather than by making settings.*.json themselves .tmpl files. Split on the first "/" exactly as
# generate_session_models.apply_pi does.
{{- $piSessionParts := splitn "/" 2 $piSession.model }}
pi_provider="{{ $piSessionParts._0 }}"
pi_model="{{ $piSessionParts._1 }}"
pi_thinking="{{ $piSession.effort }}"
patched_settings="$(mktemp)"
trap 'rm -f "$patched_settings"' EXIT
jq --arg provider "$pi_provider" --arg model "$pi_model" --arg thinking "$pi_thinking" \
  '.defaultProvider = $provider | .defaultModel = $model | .defaultThinkingLevel = $thinking' \
  "$src_settings" >"$patched_settings"

chezmoi_install_if_changed "$patched_settings" "$target_dir/settings.json" 0444
chezmoi_record_artifact --id pi-settings \
  --producer 07-merge-pi-config --profile "$profile" \
  --target "$target_dir/settings.json" --ownership-adapter whole-file \
  --input "$src_settings" \
  --input "$source_dir/.chezmoidata/ai_models/tiering.yaml" \
  --transform "$source_dir/../scripts/chezmoi_lib.sh" \
  --transform "$source_dir/.chezmoiscripts/run_onchange_after_07-merge-pi-config.sh.tmpl" \
  --consumer pi

src_models="$(chezmoi_pick_src "$is_work" "$source_dir" \
  "dot_pi/agent/readonly_models.json" \
  "dot_pi/agent/readonly_models.personal.json")"

chezmoi_install_if_changed "$src_models" "$target_dir/models.json" 0444
chezmoi_record_artifact --id pi-models \
  --producer 07-merge-pi-config --profile "$profile" \
  --target "$target_dir/models.json" --ownership-adapter whole-file \
  --input "$src_models" \
  --transform "$source_dir/../scripts/chezmoi_lib.sh" \
  --consumer pi
