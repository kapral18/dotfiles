#!/usr/bin/env bash
# Reruns when herdr changes or 07-merge-claude-code-settings reinstalls
# ~/.claude/settings.json, which drops herdr's SessionStart hook entry.
# herdr version: {{ if lookPath "herdr" }}{{ output "herdr" "--version" | trim }}{{ end }}
# claude settings merge hash: {{ includeTemplate ".chezmoiscripts/run_onchange_after_07-merge-claude-code-settings.sh.tmpl" . | sha256sum }}
set -euo pipefail

command -v herdr >/dev/null 2>&1 || exit 0

status=0
for target in pi omp claude codex; do
  herdr integration install "$target" >/dev/null || status=1
done
exit "$status"
