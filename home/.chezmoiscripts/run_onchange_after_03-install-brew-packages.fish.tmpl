#!/usr/bin/env fish

echo "---------------------------------------"
echo "brew install from Brewfile: applying..."
echo "---------------------------------------"

# Brewfile hash: {{ includeTemplate "brews/_assemble.brewfile" . | sha256sum }}

# cleanup --force resets brew trust to the Brewfile before it untaps, so a tap that
# still has installed formulae fails as untrusted. Trust and untap retired taps first.
# This grants trust to any undeclared tap and uninstalls everything installed from it.
for tap in (brew bundle cleanup --global 2>/dev/null | awk '/^Would untap:/ {on=1; next} /^$|^Run |^Would / {on=0} on')
    brew trust --tap $tap; and brew untap --force $tap
end

brew bundle cleanup --global --force
brew bundle --global --no-upgrade

echo "---------------------------------"
echo "brew install from Brewfile: done "
echo "---------------------------------"
