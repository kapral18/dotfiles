#!/usr/bin/env fish

echo "---------------------------------------"
echo "brew install from Brewfile: applying..."
echo "---------------------------------------"

# Brewfile hash: {{ includeTemplate "brews/_assemble.brewfile" . | sha256sum }}

# Cleanup resolves every Brewfile formula name, so declared taps must exist and be trusted first.
for tap in (brew bundle list --global --tap)
    brew tap $tap; or exit 1
    brew trust --tap $tap; or exit 1
end

# cleanup --force resets brew trust to the Brewfile before it untaps, so a tap that
# still has installed formulae fails as untrusted. Trust and untap retired taps first.
# This grants trust to any undeclared tap and uninstalls everything installed from it.
for tap in (brew bundle cleanup --global 2>/dev/null | awk '/^Would untap:/ {on=1; next} /^$|^Run |^Would / {on=0} on')
    brew trust --tap $tap; and brew untap --force $tap
end

set -l missing_store_apps
for app in (brew bundle list --global --mas)
    test -d "/Applications/$app.app"; or set -a missing_store_apps $app
end
if test (count $missing_store_apps) -gt 0
    open -a "App Store"
    echo "Sign in to the App Store to install: $missing_store_apps"
    read -l -P "Press Enter when signed in. " reply; or exit 1
end

set -l init_pid (cat ~/.cache/chezmoi/init-sudo 2>/dev/null)
and test "$init_pid" = (ps -o ppid= -p $fish_pid | string trim)
and set -gx HOMEBREW_SUDO_CHECKED 1

brew bundle cleanup --global --force --no-mas; or exit 1
brew bundle --global --no-upgrade; or exit 1

# Casks with a manual installer only stage their setup app; run it until the app it installs exists.
set -l caskroom (brew --caskroom)
for line in (brew info --json=v2 --cask (brew bundle list --global --cask) | jq -r '
    .casks[] | select(.installed != null)
    | [.token, .installed,
       ([.artifacts[] | .installer? // empty | .[] | .manual? // empty] | first),
       ([.artifacts[] | .uninstall? // empty | .[] | .delete? // empty] | flatten | map(select(endswith(".app"))) | first)]
    | select(.[2] != null and .[3] != null) | @tsv')
    set -l cask (string split \t -- $line)
    test -e $cask[4]; and continue
    open "$caskroom/$cask[1]/$cask[2]/$cask[3]"; or exit 1
    read -l -P "Finish the $cask[1] installer, then press Enter. " reply; or exit 1
    test -e $cask[4]; or begin
        echo "$cask[4] is still missing." >&2
        exit 1
    end
end

echo "---------------------------------"
echo "brew install from Brewfile: done "
echo "---------------------------------"
