#!/usr/bin/env bash

set -euo pipefail

# Bump this script when custom packages list or the zip-bundle helper changes so chezmoi re-runs the installer.
# custom packages list hash: {{ include "readonly_dot_default-custom-packages.tmpl" | sha256sum }}
# zip bundle helper hash: {{ output "sh" "-c" (printf "shasum -a 256 %q | cut -d' ' -f1" (joinPath .chezmoi.sourceDir "../scripts/install_github_zip_bundle.py")) | trim }}

BIN_DIR="${HOME}/.local/bin"
RELEASE_RECORD_DIR="${HOME}/.local/state/custom-packages"
CUSTOM_PACKAGES_TEMPLATE={{ joinPath .chezmoi.sourceDir "readonly_dot_default-custom-packages.tmpl" | quote }}
INSTALL_ZIP_BUNDLE={{ joinPath .chezmoi.sourceDir "../scripts/install_github_zip_bundle.py" | quote }}

mkdir -p "$BIN_DIR"

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Error: '$cmd' is required but not found in PATH" >&2
    return 1
  fi
}

resolve_release_tag() {
  local github_repo="$1"
  local requested_tag="$2"

  if [[ -z "$requested_tag" || "$requested_tag" == "latest" ]]; then
    require_cmd gh
    gh release view --repo "$github_repo" --json tagName --jq '.tagName'
    return 0
  fi

  printf '%s' "$requested_tag"
}

find_single_file() {
  local dir="$1"
  local find_args="$2"
  local what="$3"

  local files=()
  # shellcheck disable=SC2206
  files=($(eval "find \"$dir\" -maxdepth 1 -type f $find_args -print"))

  if ((${#files[@]} == 0)); then
    echo "Error: No $what downloaded in $dir" >&2
    return 1
  fi

  if ((${#files[@]} > 1)); then
    echo "Error: Multiple $what files matched in $dir:" >&2
    local f
    for f in "${files[@]}"; do
      echo "- $f" >&2
    done
    echo "Tighten the asset-pattern to match exactly one file." >&2
    return 1
  fi

  printf '%s' "${files[0]}"
}

# -----------------------------------------------
# Function to download and install DMG-based macOS apps
# -----------------------------------------------

# Usage: install_dmg_app "AppName" "owner/repo|https://..." "release-tag|latest" "App.app" [asset-pattern]
# HTTPS sources use latest and .dmg for the release tag and asset pattern.
install_dmg_app() (
  local app_name="$1"
  local github_repo="$2"
  local release_tag="$3"
  local app_bundle="$4"
  local asset_pattern="${5:-.dmg}"

  local app_path="/Applications/$app_bundle"

  if [[ -d "$app_path" ]]; then
    echo "$app_name is already installed"
    return 0
  fi

  require_cmd hdiutil || return 1

  echo "Installing $app_name..."
  local temp_dir
  temp_dir=$(mktemp -d)
  local mount_dir="$temp_dir/mount"
  mkdir -p "$mount_dir"

  local mounted=0
  cleanup_dmg_install() {
    if ((mounted == 1)); then
      hdiutil detach "$mount_dir" -quiet 2>/dev/null || true
    fi
    rm -rf "$temp_dir"
  }
  trap cleanup_dmg_install EXIT

  if [[ "$github_repo" == https://* ]]; then
    if ! curl --fail --location --show-error --output "$temp_dir/download.dmg" "$github_repo"; then
      echo "Error: Could not download $app_name from $github_repo" >&2
      return 1
    fi
  elif [[ "$release_tag" != "latest" && -n "$release_tag" ]]; then
    if ! gh release download "$release_tag" --repo "$github_repo" --pattern "*$asset_pattern" --dir "$temp_dir"; then
      echo "Error: Could not download $app_name from $github_repo" >&2
      return 1
    fi
  else
    if ! gh release download --repo "$github_repo" --pattern "*$asset_pattern" --dir "$temp_dir"; then
      echo "Error: Could not download $app_name from $github_repo" >&2
      return 1
    fi
  fi

  # Find the DMG file
  local dmg_file
  dmg_file=$(find_single_file "$temp_dir" "-name '*$asset_pattern'" "DMG")

  # Mount DMG and copy app
  hdiutil attach "$dmg_file" -quiet -nobrowse -mountpoint "$mount_dir" || return 1
  mounted=1

  if [[ ! -d "$mount_dir/$app_bundle" ]]; then
    echo "Error: Could not find $app_bundle in mounted DMG at $mount_dir" >&2
    return 1
  fi

  cp -r "$mount_dir/$app_bundle" /Applications/ || return 1

  echo "$app_name installed successfully"
)

# -----------------------------------------------
# Function to download and install GitHub release CLI binaries (no eget)
# -----------------------------------------------

download_release_asset() {
  local github_repo="$1"
  local release_tag="$2"
  local pattern="$3"
  local out_dir="$4"

  require_cmd gh || return 1
  gh release download "$release_tag" --repo "$github_repo" --pattern "$pattern" --dir "$out_dir" --clobber
}

# Each installed file/tar_gz_bin binary has a record keyed by output name that
# holds `<resolved-tag>|<repo>|<asset-pattern>|<bin-in-archive>`. Many release
# binaries have no version command, so this record is the idempotency gate;
# running a binary to guess its version can start a TUI or a real action.
# A changed asset pattern or archive member (e.g. switching arch) reinstalls.
release_record_path() {
  printf '%s/%s.release' "$RELEASE_RECORD_DIR" "$1"
}

release_is_installed() {
  local dest_path="$1"
  local output_name="$2"
  local release_id="$3"

  local record_path
  record_path=$(release_record_path "$output_name")
  [[ -x "$dest_path" && -f "$record_path" ]] || return 1
  [[ "$(<"$record_path")" == "$release_id" ]]
}

record_release() {
  local output_name="$1"
  local release_id="$2"

  mkdir -p "$RELEASE_RECORD_DIR" || return 1
  printf '%s\n' "$release_id" >"$(release_record_path "$output_name")"
}

# Callers run under `if !`, which disables errexit, so every step returns on failure.
install_release_file() {
  local tool_name="$1"
  local github_repo="$2"
  local release_tag="$3"
  local pattern="$4"
  local output_name="$5"

  local resolved_tag
  resolved_tag=$(resolve_release_tag "$github_repo" "$release_tag") && [[ -n "$resolved_tag" ]] || {
    echo "Error: Could not resolve release tag for $tool_name" >&2
    return 1
  }

  local dest_path="$BIN_DIR/$output_name"
  local release_id="$resolved_tag|$github_repo|$pattern|"
  if release_is_installed "$dest_path" "$output_name" "$release_id"; then
    echo "$tool_name is up to date ($resolved_tag)"
    return 0
  fi

  local temp_dir
  temp_dir=$(mktemp -d) || return 1
  trap 'rm -rf "$temp_dir"; trap - RETURN' RETURN

  download_release_asset "$github_repo" "$resolved_tag" "$pattern" "$temp_dir" || return 1

  local asset_path
  asset_path=$(find_single_file "$temp_dir" "" "asset") || return 1

  install -m 0755 "$asset_path" "$dest_path" || return 1
  record_release "$output_name" "$release_id" || return 1
  echo "$tool_name installed ($resolved_tag)"
}

install_release_tar_gz_bin() {
  local tool_name="$1"
  local github_repo="$2"
  local release_tag="$3"
  local pattern="$4"
  local bin_in_archive="$5"
  local output_name="$6"

  local resolved_tag
  resolved_tag=$(resolve_release_tag "$github_repo" "$release_tag") && [[ -n "$resolved_tag" ]] || {
    echo "Error: Could not resolve release tag for $tool_name" >&2
    return 1
  }

  local dest_path="$BIN_DIR/$output_name"
  local release_id="$resolved_tag|$github_repo|$pattern|$bin_in_archive"
  if release_is_installed "$dest_path" "$output_name" "$release_id"; then
    echo "$tool_name is up to date ($resolved_tag)"
    return 0
  fi

  local temp_dir
  temp_dir=$(mktemp -d) || return 1
  trap 'rm -rf "$temp_dir"; trap - RETURN' RETURN

  download_release_asset "$github_repo" "$resolved_tag" "$pattern" "$temp_dir" || return 1

  local archive_path
  archive_path=$(find_single_file "$temp_dir" "-name '*.tar.gz'" ".tar.gz") || return 1

  tar -xzf "$archive_path" -C "$temp_dir" "$bin_in_archive" || return 1
  install -m 0755 "$temp_dir/$bin_in_archive" "$dest_path" || return 1
  record_release "$output_name" "$release_id" || return 1
  echo "$tool_name installed ($resolved_tag)"
}

process_custom_package_line() {
  local raw_line="$1"

  local trimmed_line
  trimmed_line=$(printf '%s' "$raw_line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  [[ -z "$trimmed_line" || "$trimmed_line" =~ ^# ]] && return 0

  local kind=""
  kind=$(printf '%s' "$trimmed_line" | cut -d'|' -f1)

  case "$kind" in
  dmg)
    local app_name repo release_tag app_bundle asset_pattern
    IFS='|' read -r _ app_name repo release_tag app_bundle asset_pattern <<<"$trimmed_line"
    if [[ -z "${app_name:-}" || -z "${repo:-}" || -z "${release_tag:-}" || -z "${app_bundle:-}" || -z "${asset_pattern:-}" ]]; then
      echo "Error: invalid dmg line: $trimmed_line" >&2
      return 1
    fi
    install_dmg_app "$app_name" "$repo" "$release_tag" "$app_bundle" "$asset_pattern"
    ;;
  tar_gz_bin)
    local tool_name repo release_tag pattern bin_in_archive output_name
    IFS='|' read -r _ tool_name repo release_tag pattern bin_in_archive output_name <<<"$trimmed_line"
    if [[ -z "${tool_name:-}" || -z "${repo:-}" || -z "${release_tag:-}" || -z "${pattern:-}" || -z "${bin_in_archive:-}" || -z "${output_name:-}" ]]; then
      echo "Error: invalid tar_gz_bin line: $trimmed_line" >&2
      return 1
    fi
    install_release_tar_gz_bin "$tool_name" "$repo" "$release_tag" "$pattern" "$bin_in_archive" "$output_name"
    ;;
  file)
    local tool_name repo release_tag pattern output_name
    IFS='|' read -r _ tool_name repo release_tag pattern output_name <<<"$trimmed_line"
    if [[ -z "${tool_name:-}" || -z "${repo:-}" || -z "${release_tag:-}" || -z "${pattern:-}" || -z "${output_name:-}" ]]; then
      echo "Error: invalid file line: $trimmed_line" >&2
      return 1
    fi
    install_release_file "$tool_name" "$repo" "$release_tag" "$pattern" "$output_name"
    ;;
  zip_opt)
    local tool_name repo release_tag pattern bin_in_archive output_name
    IFS='|' read -r _ tool_name repo release_tag pattern bin_in_archive output_name <<<"$trimmed_line"
    if [[ -z "${tool_name:-}" || -z "${repo:-}" || -z "${release_tag:-}" || -z "${pattern:-}" || -z "${bin_in_archive:-}" || -z "${output_name:-}" ]]; then
      echo "Error: invalid zip_opt line: $trimmed_line" >&2
      return 1
    fi
    require_cmd python3
    python3 "$INSTALL_ZIP_BUNDLE" "$repo" "$release_tag" "$pattern" "${HOME}/.local/opt/${tool_name}" "$bin_in_archive" "$BIN_DIR/$output_name"
    ;;
  *)
    echo "Error: unknown custom package kind '$kind' in line: $trimmed_line" >&2
    return 1
    ;;
  esac
}

if [[ ! -f "$CUSTOM_PACKAGES_TEMPLATE" ]]; then
  echo "Error: custom packages template not found at $CUSTOM_PACKAGES_TEMPLATE" >&2
  exit 1
fi

if ! command -v chezmoi >/dev/null 2>&1; then
  echo "Error: chezmoi CLI not available" >&2
  exit 1
fi

if ! custom_rendered="$(chezmoi execute-template <"$CUSTOM_PACKAGES_TEMPLATE")"; then
  echo "Error: Failed to render custom packages template" >&2
  exit 1
fi

status=0
# Rows get /dev/null as stdin: any child that reads stdin would otherwise eat
# the remaining rows (as `mdtt version` did under the old version probe).
while IFS= read -r line || [[ -n "$line" ]]; do
  if ! process_custom_package_line "$line" </dev/null; then
    status=1
  fi
done <<<"$custom_rendered"

if [[ $status -ne 0 ]]; then
  echo "Completed with some errors while installing custom packages" >&2
  exit $status
fi

# -----------------------------------------------
# Install command-line tools
# -----------------------------------------------

# YtSurf
curl -o ~/.local/bin/ytsurf https://raw.githubusercontent.com/kapral18/ytsurf/reduce-deps/ytsurf.sh
chmod +x ~/.local/bin/ytsurf
