#!/usr/bin/env fish

# fish_plugins hash: {{ joinPath .chezmoi.sourceDir "dot_config" "fish" "readonly_fish_plugins" | include | sha256sum }}
if type -q fisher
    echo "--------------------------"
    echo "fisher update: applying..."
    echo "--------------------------"
    fisher update; or exit 1
    echo "-------------------"
    echo "fisher update: done"
    echo "-------------------"
else
    echo "-------------------------"
    echo "fisher fetch: applying..."
    echo "-------------------------"
    set -l fisher_src (mktemp)
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/4.4.8/functions/fisher.fish -o $fisher_src; or exit 1
    source $fisher_src; and rm -f $fisher_src
    fisher update; or exit 1
    echo "------------------"
    echo "fisher fetch: done"
    echo "------------------"
end

echo ""
