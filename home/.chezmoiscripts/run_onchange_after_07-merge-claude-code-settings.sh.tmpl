#!/usr/bin/env bash

set -euo pipefail

{{- if eq .isWork true }}
# claude code settings desired hash (work): {{ include "dot_claude/settings.work.json" | sha256sum }}
{{- else }}
# claude code settings desired hash (non-work): {{ include "dot_claude/settings.personal.json" | sha256sum }}
{{- end }}
# chezmoi_lib.sh hash: {{ include "../scripts/chezmoi_lib.sh" | sha256sum }}
# managed_config_manifest.py hash: {{ include "../scripts/managed_config_manifest.py" | sha256sum }}
# generated_artifact_ledger.py hash: {{ include "../scripts/generated_artifact_ledger.py" | sha256sum }}
{{- /* shfmt parses this file as shell, and a parenthesised template call trips its lexer. */}}
{{- $session := index .session_models "claude_code" }}
# session_models.claude_code hash: {{ $session | toJson | sha256sum }}

source_dir="${CHEZMOI_SOURCE_DIR:-{{ .chezmoi.sourceDir }}}"
# shellcheck source=../../../scripts/chezmoi_lib.sh
source "$source_dir/../scripts/chezmoi_lib.sh"

is_work="{{ if eq .isWork true }}true{{ else }}false{{ end }}"
profile="{{ if eq .isWork true }}work{{ else }}personal{{ end }}"
src="$(chezmoi_pick_src "$is_work" "$source_dir" "dot_claude/settings.work.json" "dot_claude/settings.personal.json")"

# the source settings json is regenerated from session_models by scripts/generate_session_models.py; this apply-time patch is the backstop.
# Patch both fields from the rendered registry values before installing. include() does not recursively
# render .tmpl content, so this substitution happens here, at apply time, not by making settings.*.json
# themselves .tmpl files.
tier_model="{{ $session.model }}"
tier_effort="{{ $session.effort }}"
patched="$(mktemp)"
trap 'rm -f "$patched"' EXIT
jq --arg model "$tier_model" --arg effort "$tier_effort" \
  '.model = $model | .effortLevel = $effort' \
  "$src" >"$patched"

chezmoi_install_if_changed "$patched" "$HOME/.claude/settings.json"
chezmoi_record_artifact --id claude-settings \
  --producer 07-merge-claude-code-settings --profile "$profile" \
  --target "$HOME/.claude/settings.json" --ownership-adapter whole-file \
  --input "$src" \
  --input "$source_dir/.chezmoidata/ai_models/tiering.yaml" \
  --transform "$source_dir/../scripts/chezmoi_lib.sh" \
  --transform "$source_dir/.chezmoiscripts/run_onchange_after_07-merge-claude-code-settings.sh.tmpl" \
  --consumer claude
