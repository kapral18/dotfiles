#!/usr/bin/env bash
# Description: Launch GitHub Copilot CLI through OpenRouter's OpenAI-compatible endpoint.

set -euo pipefail

if ! command -v copilot >/dev/null 2>&1; then
  echo "Error: copilot CLI not found on PATH." >&2
  exit 127
fi

api_key="${OPENROUTER_API_KEY:-}"
if [[ -z "$api_key" ]]; then
  echo "Error: set OPENROUTER_API_KEY." >&2
  exit 1
fi

# Model and effort are selectable; the pin rides the model slug. The anthropic client cannot inject
# the OpenRouter `provider` body object, so Kimi's throughput-sorted Fireworks/Together/BaseTen-only+$16/M policy, DeepSeek's FP8-or-higher,
# throughput-only policy, and effort ride an OpenRouter preset: OpenRouter resolves `<model>@preset/<slug>` on
# /api/v1/messages (live-probed 2026-08-07, served by Wafer). Each `<family>-lanes-<level>` preset
# bakes model+provider+effort; `deepseek-lanes-max` is the default.
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"
OPENROUTER_EFFORT="max"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model | -m)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_MODEL="$2"
    shift 2
    ;;
  --model=*)
    OPENROUTER_MODEL="${1#*=}"
    shift
    ;;
  --effort | --reasoning-effort | --thinking)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_EFFORT="$2"
    shift 2
    ;;
  --effort=* | --reasoning-effort=* | --thinking=*)
    OPENROUTER_EFFORT="${1#*=}"
    shift
    ;;
  --no-thinking)
    OPENROUTER_EFFORT="minimal"
    shift
    ;;
  --)
    args+=("$1")
    shift
    args+=("$@")
    break
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done

# Map model+effort to a preset slug. glm, kimi, deepseek, and terra all have a real `max` (kimi's
# OpenRouter max tier re-probed live 2026-08-07: max returned 1.9x high's reasoning tokens across
# 6 pairs on 2 prompts, overturning the 2026-08-05 falsification). `none` disables reasoning via
# the matching `*-lanes-none` / `effort-none` workspace presets. Unknown models use the
# model-agnostic `effort-<level>` preset (no provider policy).
preset_family() {
  case "$1" in
  moonshotai/kimi-k3*) echo "kimi" ;;
  deepseek/*) echo "deepseek" ;;
  z-ai/glm-5.2*) echo "glm" ;;
  openai/gpt-5.6-terra*) echo "terra" ;;
  *) echo "" ;;
  esac
}
if [[ -z "$OPENROUTER_MODEL" || -z "$OPENROUTER_EFFORT" ]]; then
  echo "Error: --model and --effort require non-empty values." >&2
  exit 2
fi
family="$(preset_family "$OPENROUTER_MODEL")"
preset_effort="$OPENROUTER_EFFORT"
if [[ -z "$family" ]]; then
  preset_slug="effort-$preset_effort"
elif [[ "$OPENROUTER_MODEL" == "moonshotai/kimi-k3" && "$preset_effort" == "high" ]]; then
  preset_slug="kimi-lanes"
else
  preset_slug="$family-lanes-$preset_effort"
fi
readonly OPENROUTER_WIRE_MODEL="$OPENROUTER_MODEL@preset/$preset_slug"

# Copilot picks the BYOK client kind once per launch, and only the anthropic one
# emits cache_control breakpoints; its openai client never does. A session started
# on the openai client therefore loses prompt caching for every Anthropic model it
# later reaches. OpenRouter answers /v1/messages for the pinned model, so this route always uses
# the cache-capable Anthropic client.
export COPILOT_PROVIDER_TYPE=anthropic
export COPILOT_PROVIDER_BASE_URL="https://openrouter.ai/api"
export COPILOT_PROVIDER_API_KEY="$api_key"
export COPILOT_MODEL="$OPENROUTER_MODEL"
export COPILOT_PROVIDER_WIRE_MODEL="$OPENROUTER_WIRE_MODEL"
export COPILOT_PROVIDER_MAX_PROMPT_TOKENS="${COPILOT_OPENROUTER_MAX_PROMPT_TOKENS:-1048576}"
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS="${COPILOT_OPENROUTER_MAX_OUTPUT_TOKENS:-131072}"
unset COPILOT_PROVIDER_MODEL_ID COPILOT_PROVIDER_WIRE_API

# Delegated lanes carry the native Copilot band ids, and those travel to OpenRouter as their own
# wire model: in the original probe `explore` reached openai/gpt-5.3-codex and `review-worker`
# claude-opus-5 from a session pinned to a different model. The band gate resolves the spawn, so
# the override belongs there; COPILOT_HOME cannot do it, because settings.json and agent
# frontmatter both lose to the hook.
export AGENT_BAND_MODEL_OVERRIDE="$OPENROUTER_WIRE_MODEL"
export AGENT_BAND_EFFORT_OVERRIDE="high"

exec ",copilot" --model "$OPENROUTER_MODEL" --effort high "${args[@]}"
