#!/usr/bin/env bash
# Description: Launch GitHub Copilot CLI through OpenRouter's OpenAI-compatible endpoint.

set -euo pipefail

if ! command -v copilot >/dev/null 2>&1; then
  echo "Error: copilot CLI not found on PATH." >&2
  exit 127
fi

api_key="${OPENROUTER_API_KEY:-}"
if [[ -z "$api_key" ]]; then
  echo "Error: set OPENROUTER_API_KEY." >&2
  exit 1
fi

readonly OPENROUTER_MODEL="moonshotai/kimi-k3"
readonly OPENROUTER_EFFORT="high"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model | -m | --model=* | --effort | --reasoning-effort | --thinking | --effort=* | --reasoning-effort=* | --thinking=* | --no-thinking)
    echo "Error: ,copilot-openrouter pins OpenRouter to $OPENROUTER_MODEL at $OPENROUTER_EFFORT effort; $1 is not supported." >&2
    exit 2
    ;;
  --)
    args+=("$1")
    shift
    args+=("$@")
    break
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done

# Copilot picks the BYOK client kind once per launch, and only the anthropic one
# emits cache_control breakpoints; its openai client never does. A session started
# on the openai client therefore loses prompt caching for every Anthropic model it
# later reaches. OpenRouter answers /v1/messages for the pinned model, so this route always uses
# the cache-capable Anthropic client.
export COPILOT_PROVIDER_TYPE=anthropic
export COPILOT_PROVIDER_BASE_URL="https://openrouter.ai/api"
export COPILOT_PROVIDER_API_KEY="$api_key"
export COPILOT_MODEL="$OPENROUTER_MODEL"
export COPILOT_PROVIDER_WIRE_MODEL="$OPENROUTER_MODEL"
export COPILOT_PROVIDER_MAX_PROMPT_TOKENS="${COPILOT_OPENROUTER_MAX_PROMPT_TOKENS:-1048576}"
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS="${COPILOT_OPENROUTER_MAX_OUTPUT_TOKENS:-131072}"
unset COPILOT_PROVIDER_MODEL_ID COPILOT_PROVIDER_WIRE_API

# Delegated lanes carry the native Copilot band ids, and those travel to OpenRouter as their own
# wire model: in the original probe `explore` reached openai/gpt-5.3-codex and `review-worker`
# claude-opus-5 from a session pinned to a different model. The band gate resolves the spawn, so
# the override belongs there; COPILOT_HOME cannot do it, because settings.json and agent
# frontmatter both lose to the hook.
export AGENT_BAND_MODEL_OVERRIDE="$OPENROUTER_MODEL"
export AGENT_BAND_EFFORT_OVERRIDE="$OPENROUTER_EFFORT"

exec ",copilot" --model "$OPENROUTER_MODEL" --effort "$OPENROUTER_EFFORT" "${args[@]}"
