#!/usr/bin/env bash
# Description: Launch Claude Code through OpenRouter's Anthropic-Messages endpoint.

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "Error: claude CLI not found on PATH." >&2
  exit 127
fi

api_key="${OPENROUTER_API_KEY:-}"
if [[ -z "$api_key" ]] && command -v pass >/dev/null 2>&1; then
  api_key="$(pass show openrouter/api/token 2>/dev/null | tr -d '\n')"
fi
api_key="$(printf '%s' "$api_key" | tr -d '[:space:]')"
if [[ -z "$api_key" ]]; then
  echo "Error: set OPENROUTER_API_KEY or pass entry openrouter/api/token." >&2
  exit 1
fi

# Model and effort are selectable. Claude Code has no extra-body channel, so effort rides a
# model-agnostic OpenRouter workspace preset: `<model>@preset/effort-<level>` on /api/v1/messages.
# Every --model uses the same slug. Presets are workspace state via
# POST /api/v1/presets/<slug>/chat/completions.
OPENROUTER_MODEL="z-ai/glm-5.3-flash"
OPENROUTER_EFFORT="high"
OPENROUTER_CONTEXT="short"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model | -m)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_MODEL="$2"
    shift 2
    ;;
  --model=*)
    OPENROUTER_MODEL="${1#*=}"
    shift
    ;;
  --effort | --reasoning-effort | --thinking)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_EFFORT="$2"
    shift 2
    ;;
  --effort=* | --reasoning-effort=* | --thinking=*)
    OPENROUTER_EFFORT="${1#*=}"
    shift
    ;;
  --no-thinking)
    OPENROUTER_EFFORT="minimal"
    shift
    ;;
  --context)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_CONTEXT="$2"
    shift 2
    ;;
  --context=*)
    OPENROUTER_CONTEXT="${1#*=}"
    shift
    ;;
  --fallback-model | --fallback-model=* | --agents | --agents=*)
    echo "Error: ,claude-openrouter pins OpenRouter; $1 is not supported." >&2
    exit 2
    ;;
  --)
    args+=("$1")
    shift
    args+=("$@")
    break
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done

# Every --model/--effort pair composes the same slug. `none` disables reasoning via
# the `effort-none` workspace preset. OpenRouter rejects `ultra` on these slugs.
if [[ -z "$OPENROUTER_MODEL" || -z "$OPENROUTER_EFFORT" || -z "$OPENROUTER_CONTEXT" ]]; then
  echo "Error: --model, --effort, and --context require non-empty values." >&2
  exit 2
fi
if [[ "$OPENROUTER_CONTEXT" != "short" && "$OPENROUTER_CONTEXT" != "long" ]]; then
  echo "Error: unsupported context tier '$OPENROUTER_CONTEXT'; choose: short, long." >&2
  exit 2
fi
readonly OPENROUTER_PRESET_HELPER="$HOME/lib/shared/openrouter_presets.py"
if [[ ! -x "$OPENROUTER_PRESET_HELPER" ]]; then
  echo "Error: OpenRouter preset helper missing at $OPENROUTER_PRESET_HELPER." >&2
  exit 1
fi
export OPENROUTER_API_KEY="$api_key"
readonly OPENROUTER_WIRE_MODEL="$OPENROUTER_MODEL@preset/effort-$OPENROUTER_EFFORT"
readonly OPENROUTER_CLAUDE_MODEL="$OPENROUTER_WIRE_MODEL"
readonly OPENROUTER_PI_T1_WIRE_MODEL="anthropic/claude-fable-5.1@preset/effort-high"
readonly OPENROUTER_PI_T2_WIRE_MODEL="openai/gpt-5.6-sol@preset/effort-high"
readonly OPENROUTER_PI_MECHANICAL_WIRE_MODEL="z-ai/glm-5.3-flash@preset/effort-high"
readonly OPENROUTER_PI_MEMORY_WIRE_MODEL="google/gemini-3.8-flash@preset/effort-low"
readonly OPENROUTER_PI_REFUTE_WIRE_MODEL="openai/gpt-5.6-sol@preset/effort-xhigh"
"$OPENROUTER_PRESET_HELPER" "$OPENROUTER_EFFORT"
if [[ "$OPENROUTER_EFFORT" != "xhigh" ]]; then
  "$OPENROUTER_PRESET_HELPER" xhigh
fi
if [[ "$OPENROUTER_EFFORT" != "high" ]]; then
  "$OPENROUTER_PRESET_HELPER" high
fi
if [[ "$OPENROUTER_EFFORT" != "low" ]]; then
  "$OPENROUTER_PRESET_HELPER" low
fi
session_budget="$("$OPENROUTER_PRESET_HELPER" --session-budget-env "$OPENROUTER_CONTEXT" \
  "$OPENROUTER_MODEL" "$OPENROUTER_PI_T1_WIRE_MODEL" "$OPENROUTER_PI_T2_WIRE_MODEL" \
  "$OPENROUTER_PI_MECHANICAL_WIRE_MODEL" "$OPENROUTER_PI_MEMORY_WIRE_MODEL" "$OPENROUTER_PI_REFUTE_WIRE_MODEL")"
while IFS='=' read -r budget_name budget_value; do
  case "$budget_name" in
  CONTEXT_LIMIT) OPENROUTER_CONTEXT_LIMIT="$budget_value" ;;
  MAX_OUTPUT_TOKENS) OPENROUTER_MAX_OUTPUT_TOKENS="$budget_value" ;;
  PROMPT_LIMIT) OPENROUTER_PROMPT_LIMIT="$budget_value" ;;
  esac
done <<<"$session_budget"
if [[ -z "${OPENROUTER_CONTEXT_LIMIT:-}" || -z "${OPENROUTER_PROMPT_LIMIT:-}" ]]; then
  echo "Error: OpenRouter context preflight returned an incomplete session budget." >&2
  exit 1
fi
readonly OPENROUTER_CONTEXT_LIMIT OPENROUTER_MAX_OUTPUT_TOKENS OPENROUTER_PROMPT_LIMIT

# Claude Code appends /v1/messages, so the base URL stops at /api. OpenRouter answers
# that path with the Anthropic Messages schema, usage block included.
# Claude Code's Agent tool accepts family aliases, not arbitrary OpenRouter model ids, so each
# alias slot carries one Pi lane wire model and the gate
# (band_gate.py:_claude_alias_for_backend_model) projects every Pi backend pick onto the slot its
# model family matches. The alias ladder haiku < sonnet < opus < fable is the tier order here:
#   fable  -> T1 research/review/orchestrate   anthropic/claude-fable-5.1   high
#   opus   -> T2 implement                     openai/gpt-5.6-sol           high
#   sonnet -> T3 mechanical                    z-ai/glm-5.3-flash   high
#   haiku  -> memory                           google/gemini-3.8-flash      low
# Pi's refute pick (openai/gpt-5.6-sol xhigh) has no exact alias slot.
# The gate denies that launch instead of substituting the implement lane at high.
# CLAUDE_CODE_SUBAGENT_MODEL is the fallback for spawns the gate leaves unbound, hence T2.
# The OpenRouter preset carries the real effort; the Claude client effort
# mirrors it when Claude supports the level, with low as the safe client gate for non-thinking presets.
case "$OPENROUTER_EFFORT" in
low | medium | high | xhigh | max)
  CLAUDE_EFFORT="$OPENROUTER_EFFORT"
  ;;
none | minimal)
  CLAUDE_EFFORT="low"
  ;;
*)
  echo "Error: unsupported Claude client effort '$OPENROUTER_EFFORT'; choose: none, minimal, low, medium, high, xhigh, max." >&2
  exit 2
  ;;
esac
readonly CLAUDE_EFFORT
export ANTHROPIC_MODEL="$OPENROUTER_CLAUDE_MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$OPENROUTER_PI_T1_WIRE_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$OPENROUTER_PI_T2_WIRE_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$OPENROUTER_PI_MECHANICAL_WIRE_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$OPENROUTER_PI_MEMORY_WIRE_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$OPENROUTER_PI_T2_WIRE_MODEL"
export CLAUDE_CODE_DISABLE_THINKING=1
export CLAUDE_CODE_EFFORT_LEVEL="$CLAUDE_EFFORT"
# Claude has one process-wide compaction threshold for the root and alias lanes.
# Its own consumer clamps AUTO_COMPACT to a small model's MAX_CONTEXT, so preserve
# a sub-100k provider budget instead of inflating it to Claude's 100k default.
unset CLAUDE_CODE_MAX_CONTEXT_TOKENS CLAUDE_CODE_AUTO_COMPACT_WINDOW
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$OPENROUTER_PROMPT_LIMIT"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$OPENROUTER_MAX_OUTPUT_TOKENS"
CLAUDE_AUTO_COMPACT="$OPENROUTER_PROMPT_LIMIT"
if ((CLAUDE_AUTO_COMPACT > 1000000)); then
  CLAUDE_AUTO_COMPACT=1000000
fi
readonly CLAUDE_AUTO_COMPACT
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$CLAUDE_AUTO_COMPACT"
unset AGENT_BAND_MODEL_OVERRIDE AGENT_BAND_EFFORT_OVERRIDE
unset AGENT_BAND_SUBSCRIPTION AGENT_BAND_CLAUDE_ROUTES AGENT_BAND_CODEX_ROUTES
export AGENT_BAND_SCHEMA_HARNESS="pi"
export AGENT_BAND_MODEL_FORMAT="openrouter-preset"
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$api_key"
export ANTHROPIC_API_KEY=""
unset ANTHROPIC_CUSTOM_HEADERS

exec claude --model "$OPENROUTER_CLAUDE_MODEL" --effort "$CLAUDE_EFFORT" "${args[@]}"
