#!/usr/bin/env bash
# Description: Grep for a string in files and open the results in fzf

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Usage: grepo <search_pattern>"
  exit 1
fi

# Passed through the environment so the pattern is never parsed as shell code by fzf's $SHELL.
export GREPO_PATTERN="$1" GREPO_EDITOR="${EDITOR:-nvim}" GREPO_SHELL="${SHELL:-}"

# bash runs the binding so a multi-word EDITOR splits; the editor gets the user's shell back.
rg -l -- "$1" | SHELL=bash fzf --bind 'enter:execute(SHELL="$GREPO_SHELL" $GREPO_EDITOR "+/$GREPO_PATTERN" "+norm! n" {})' --preview "bat --style=numbers --color=always {}"
