#!/usr/bin/env bash
# Description: Launch Codex through the repo-owned GitHub Copilot subscription adapter.

set -euo pipefail

lib="${COPILOT_ADAPTER_LIB:-$HOME/lib/,copilot-adapter/main.py}"
if [[ ! -f "$lib" ]]; then
  echo "Error: Copilot adapter not found at $lib. Run chezmoi apply --no-tty ~/lib/,copilot-adapter." >&2
  exit 127
fi

unset AGENT_BAND_MODEL_OVERRIDE AGENT_BAND_EFFORT_OVERRIDE AGENT_BAND_MODEL_FORMAT
export AGENT_BAND_SCHEMA_HARNESS="copilot"
exec python3 "$lib" codex "$@"
