#!/usr/bin/env bash
# Description: Launch Codex against OpenRouter's OpenAI Responses endpoint.

set -euo pipefail

codex_bin="${CODEX_WRAPPER_BIN:-$HOME/bin/,codex}"
if [[ ! -x "$codex_bin" ]]; then
  echo "Error: ,codex wrapper not found at $codex_bin. Run chezmoi apply --no-tty ~/bin/,codex." >&2
  exit 127
fi

api_key="${OPENROUTER_API_KEY:-}"
if [[ -z "$api_key" ]] && command -v pass >/dev/null 2>&1; then
  api_key="$(pass show openrouter/api/token 2>/dev/null | tr -d '\n')"
fi
api_key="$(printf '%s' "$api_key" | tr -d '[:space:]')"
if [[ -z "$api_key" ]]; then
  echo "Error: set OPENROUTER_API_KEY or pass entry openrouter/api/token." >&2
  exit 1
fi
export OPENROUTER_API_KEY="$api_key"

# Model and effort are selectable. Codex's model_providers schema is deny_unknown_fields with no
# extra-body channel, so effort rides a model-agnostic OpenRouter workspace preset:
# `<model>@preset/effort-<level>` on /api/v1/responses. Every --model uses the same slug.
# `model_reasoning_effort` stays unset so the preset is the single source of effort.
OPENROUTER_MODEL="z-ai/glm-5.3-flash"
OPENROUTER_EFFORT="high"
OPENROUTER_CONTEXT="short"

cli_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model | -m)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_MODEL="$2"
    shift 2
    ;;
  --model=*)
    OPENROUTER_MODEL="${1#*=}"
    shift
    ;;
  --effort | --reasoning-effort | --thinking)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_EFFORT="$2"
    shift 2
    ;;
  --effort=* | --reasoning-effort=* | --thinking=*)
    OPENROUTER_EFFORT="${1#*=}"
    shift
    ;;
  --no-thinking)
    OPENROUTER_EFFORT="minimal"
    shift
    ;;
  --context)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_CONTEXT="$2"
    shift 2
    ;;
  --context=*)
    OPENROUTER_CONTEXT="${1#*=}"
    shift
    ;;
  -c | -c=* | --config | --config=* | --profile | --profile=*)
    echo "Error: ,codex-openrouter pins OpenRouter; $1 is not supported." >&2
    exit 2
    ;;
  --)
    cli_args+=("$1")
    shift
    cli_args+=("$@")
    break
    ;;
  *)
    cli_args+=("$1")
    shift
    ;;
  esac
done

# Every --model/--effort pair composes the same slug. `none` disables reasoning via
# the `effort-none` workspace preset. OpenRouter rejects `ultra` on these slugs.
if [[ -z "$OPENROUTER_MODEL" || -z "$OPENROUTER_EFFORT" || -z "$OPENROUTER_CONTEXT" ]]; then
  echo "Error: --model, --effort, and --context require non-empty values." >&2
  exit 2
fi
if [[ "$OPENROUTER_CONTEXT" != "short" && "$OPENROUTER_CONTEXT" != "long" ]]; then
  echo "Error: unsupported context tier '$OPENROUTER_CONTEXT'; choose: short, long." >&2
  exit 2
fi
readonly OPENROUTER_PRESET_HELPER="$HOME/lib/shared/openrouter_presets.py"
if [[ ! -x "$OPENROUTER_PRESET_HELPER" ]]; then
  echo "Error: OpenRouter preset helper missing at $OPENROUTER_PRESET_HELPER." >&2
  exit 1
fi
export OPENROUTER_API_KEY="$api_key"
"$OPENROUTER_PRESET_HELPER" "$OPENROUTER_EFFORT"
if [[ "$OPENROUTER_EFFORT" != "xhigh" ]]; then
  "$OPENROUTER_PRESET_HELPER" xhigh
fi
if [[ "$OPENROUTER_EFFORT" != "high" ]]; then
  "$OPENROUTER_PRESET_HELPER" high
fi
if [[ "$OPENROUTER_EFFORT" != "low" ]]; then
  "$OPENROUTER_PRESET_HELPER" low
fi
readonly OPENROUTER_WIRE_MODEL="$OPENROUTER_MODEL@preset/effort-$OPENROUTER_EFFORT"
readonly OPENROUTER_PI_T1_WIRE_MODEL="anthropic/claude-fable-5.1@preset/effort-high"
readonly OPENROUTER_PI_T2_WIRE_MODEL="openai/gpt-5.6-sol@preset/effort-high"
readonly OPENROUTER_PI_MECHANICAL_WIRE_MODEL="z-ai/glm-5.3-flash@preset/effort-high"
readonly OPENROUTER_PI_MEMORY_WIRE_MODEL="google/gemini-3.8-flash@preset/effort-low"
readonly OPENROUTER_PI_REFUTE_WIRE_MODEL="openai/gpt-5.6-sol@preset/effort-xhigh"

codex_catalog="$(mktemp -t ,codex-openrouter-model-catalog.XXXXXX)"
codex_catalog_cleanup() {
  rm -f "$codex_catalog"
}
trap codex_catalog_cleanup EXIT
"$OPENROUTER_PRESET_HELPER" --codex-model-catalog "$OPENROUTER_CONTEXT" \
  "$OPENROUTER_WIRE_MODEL" "$OPENROUTER_PI_T1_WIRE_MODEL" "$OPENROUTER_PI_T2_WIRE_MODEL" \
  "$OPENROUTER_PI_MECHANICAL_WIRE_MODEL" "$OPENROUTER_PI_MEMORY_WIRE_MODEL" \
  "$OPENROUTER_PI_REFUTE_WIRE_MODEL" >"$codex_catalog"

# OpenRouter answers /api/v1/responses, and Codex 0.146.0 attaches its full built-in tool set
# behind a provider-prefixed slug there, so no wire rewriting is needed on this route.
args=(
  -c "model_providers.openrouter.base_url=\"https://openrouter.ai/api/v1\""
  -c "model_providers.openrouter.name=\"OpenRouter\""
  -c "model_providers.openrouter.env_key=\"OPENROUTER_API_KEY\""
  -c "model_providers.openrouter.wire_api=\"responses\""
  -c "model_provider=\"openrouter\""
  # The selected catalog owns every route's per-model capacity. These large
  # overrides neutralize inherited global caps; Codex clamps them per catalog
  # entry, including the 90% automatic-compaction ceiling.
  -c "model_context_window=9223372036854775807"
  -c "model_auto_compact_token_limit=9223372036854775807"
  -c "model_catalog_json=\"$codex_catalog\""
  --model "$OPENROUTER_WIRE_MODEL"
)

# spawn_agent emits in Codex's tool shape, but model choices come from Pi's OpenRouter-compatible
# category matrix. The gate strips the `openrouter/` prefix and turns `:<level>` into
# `@preset/effort-<level>`, which is the wire format this route serves.
unset AGENT_BAND_MODEL_OVERRIDE AGENT_BAND_EFFORT_OVERRIDE
unset AGENT_BAND_SUBSCRIPTION AGENT_BAND_CLAUDE_ROUTES AGENT_BAND_CODEX_ROUTES
export AGENT_BAND_SCHEMA_HARNESS="pi"
export AGENT_BAND_MODEL_FORMAT="openrouter-preset"

# Native role settings apply after spawn arguments. Project model-free managed
# leaves for this process so the exact OpenRouter lane survives that merge.
python3 "$HOME/lib/shared/codex_lanes.py" "$codex_catalog" -- "$codex_bin" "${args[@]}" "${cli_args[@]}"
exit $?
