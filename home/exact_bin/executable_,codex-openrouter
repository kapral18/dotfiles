#!/usr/bin/env bash
# Description: Launch Codex against OpenRouter's OpenAI Responses endpoint.

set -euo pipefail

codex_bin="${CODEX_WRAPPER_BIN:-$HOME/bin/,codex}"
if [[ ! -x "$codex_bin" ]]; then
  echo "Error: ,codex wrapper not found at $codex_bin. Run chezmoi apply --no-tty ~/bin/,codex." >&2
  exit 127
fi

api_key="${OPENROUTER_API_KEY:-}"
if [[ -z "$api_key" ]] && command -v pass >/dev/null 2>&1; then
  api_key="$(pass show openrouter/api/token 2>/dev/null | tr -d '\n')"
fi
if [[ -z "$api_key" ]]; then
  echo "Error: set OPENROUTER_API_KEY or pass entry openrouter/api/token." >&2
  exit 1
fi
export OPENROUTER_API_KEY="$api_key"

# Model and effort are selectable; the pin rides the model slug. Codex's model_providers schema is
# deny_unknown_fields with no extra-body channel, so Kimi's throughput-sorted Fireworks/Together/BaseTen-only+$16/M policy, DeepSeek's
# FP8-or-higher, throughput-only policy, and effort ride an OpenRouter preset: OpenRouter resolves
# `<model>@preset/<slug>` on /api/v1/responses (live-probed 2026-08-07). Each `<family>-lanes-<level>`
# preset bakes model+provider+effort; `deepseek-lanes-max` is the default. `model_reasoning_effort` is
# left unset so the preset is the single source of effort (a body field would fight the preset).
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"
OPENROUTER_EFFORT="max"

cli_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --model | -m)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_MODEL="$2"
    shift 2
    ;;
  --model=*)
    OPENROUTER_MODEL="${1#*=}"
    shift
    ;;
  --effort | --reasoning-effort | --thinking)
    [[ $# -ge 2 ]] || {
      echo "Error: $1 requires a value." >&2
      exit 2
    }
    OPENROUTER_EFFORT="$2"
    shift 2
    ;;
  --effort=* | --reasoning-effort=* | --thinking=*)
    OPENROUTER_EFFORT="${1#*=}"
    shift
    ;;
  --no-thinking)
    OPENROUTER_EFFORT="minimal"
    shift
    ;;
  -c | -c=* | --config | --config=* | --profile | --profile=*)
    echo "Error: ,codex-openrouter pins OpenRouter; $1 is not supported." >&2
    exit 2
    ;;
  --)
    cli_args+=("$1")
    shift
    cli_args+=("$@")
    break
    ;;
  *)
    cli_args+=("$1")
    shift
    ;;
  esac
done

# Map model+effort to a preset slug. glm, kimi, deepseek, and terra all have a real `max` (kimi's
# OpenRouter max tier re-probed live 2026-08-07: max returned 1.9x high's reasoning tokens across
# 6 pairs on 2 prompts, overturning the 2026-08-05 falsification). `none` disables reasoning via
# the matching `*-lanes-none` / `effort-none` workspace presets. Unknown models use the
# model-agnostic `effort-<level>` preset (no provider policy).
preset_family() {
  case "$1" in
  moonshotai/kimi-k3*) echo "kimi" ;;
  deepseek/*) echo "deepseek" ;;
  z-ai/glm-5.2*) echo "glm" ;;
  openai/gpt-5.6-terra*) echo "terra" ;;
  *) echo "" ;;
  esac
}
if [[ -z "$OPENROUTER_MODEL" || -z "$OPENROUTER_EFFORT" ]]; then
  echo "Error: --model and --effort require non-empty values." >&2
  exit 2
fi
family="$(preset_family "$OPENROUTER_MODEL")"
preset_effort="$OPENROUTER_EFFORT"
if [[ -z "$family" ]]; then
  preset_slug="effort-$preset_effort"
elif [[ "$OPENROUTER_MODEL" == "moonshotai/kimi-k3" && "$preset_effort" == "high" ]]; then
  preset_slug="kimi-lanes"
else
  preset_slug="$family-lanes-$preset_effort"
fi
readonly OPENROUTER_WIRE_MODEL="$OPENROUTER_MODEL@preset/$preset_slug"

# OpenRouter answers /api/v1/responses, and Codex 0.146.0 attaches its full built-in tool set
# behind a provider-prefixed slug there, so no wire rewriting is needed on this route.
args=(
  -c "model_providers.openrouter.base_url=\"https://openrouter.ai/api/v1\""
  -c "model_providers.openrouter.name=\"OpenRouter\""
  -c "model_providers.openrouter.env_key=\"OPENROUTER_API_KEY\""
  -c "model_providers.openrouter.wire_api=\"responses\""
  -c "model_provider=\"openrouter\""
  --model "$OPENROUTER_WIRE_MODEL"
)

# spawn_agent otherwise carries the native codex band ids, which reach OpenRouter unprefixed. The
# effort override stays at high for the band gate's display; the preset carries the real effort.
export AGENT_BAND_MODEL_OVERRIDE="$OPENROUTER_WIRE_MODEL"
export AGENT_BAND_EFFORT_OVERRIDE="high"

exec "$codex_bin" "${args[@]}" "${cli_args[@]}"
