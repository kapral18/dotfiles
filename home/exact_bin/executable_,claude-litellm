#!/usr/bin/env bash
# Description: Launch Claude Code through the LiteLLM gateway.

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "Error: claude CLI not found on PATH." >&2
  exit 127
fi

read_pass_secret() {
  local path="$1"
  if command -v pass >/dev/null 2>&1; then
    pass show "$path" 2>/dev/null | tr -d '\n'
  fi
}

litellm_api_base="${LITELLM_API_BASE:-}"
if [[ -z "$litellm_api_base" ]]; then
  litellm_api_base="$(read_pass_secret litellm/api/base)"
fi
if [[ -z "$litellm_api_base" ]]; then
  echo "Error: set LITELLM_API_BASE or pass entry litellm/api/base." >&2
  exit 1
fi
litellm_api_base="${litellm_api_base%/}"
litellm_api_base="${litellm_api_base%/v1}"

litellm_api_key="${LITELLM_PROXY_KEY:-}"
if [[ -z "$litellm_api_key" ]]; then
  litellm_api_key="$(read_pass_secret litellm/api/token)"
fi
if [[ -z "$litellm_api_key" ]]; then
  echo "Error: set LITELLM_PROXY_KEY or pass entry litellm/api/token." >&2
  exit 1
fi

# Opus, Sonnet, Fable, and subagent defaults carry the [1m] selector so Claude
# Code's BM(e) short-circuit sets the model window to 1e6 for autocompact math;
# without it, `llm-gateway/`-prefixed ids miss the client registry and fall
# back to the ~200k default (autocompact fires at ~180k). Haiku 4.5 has no
# `haiku[1m]` selector in the client registry, so it stays bare.
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-llm-gateway/claude-opus-4-8[1m]}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-llm-gateway/claude-haiku-4-5}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-llm-gateway/claude-sonnet-5[1m]}"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-llm-gateway/claude-opus-4-8[1m]}"
export CLAUDE_CODE_DISABLE_THINKING="${CLAUDE_CODE_DISABLE_THINKING:-1}"
export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-high}"
export ANTHROPIC_BASE_URL="$litellm_api_base"
export ANTHROPIC_AUTH_TOKEN="$litellm_api_key"
export ANTHROPIC_API_KEY=""
unset ANTHROPIC_CUSTOM_HEADERS

exec claude "$@"
