#!/usr/bin/env bash

set -euo pipefail

yarn_pkgs_file="$HOME/.default-yarn-pkgs"

if [[ ! -f "$yarn_pkgs_file" ]]; then
  echo "Error: default-yarn-pkgs file not found at $yarn_pkgs_file"
  exit 1
fi

# Get desired packages
desired_pkgs=()
while IFS= read -r line || [[ -n "$line" ]]; do
  # Trim leading and trailing whitespace
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"

  # Skip empty lines and comments
  [[ -z "$line" || "$line" =~ ^# ]] && continue
  desired_pkgs+=("$line")
done <"$yarn_pkgs_file"

# Split each entry into package name and optional version pin. The version
# tag is the part after the LAST `@` when it is not the leading scope marker
# (`@org/pkg@1.2.3` -> name `@org/pkg`, pin `1.2.3`).
desired_names=()
desired_pins=()
for entry in "${desired_pkgs[@]}"; do
  name="$entry"
  pin=""
  if [[ "${entry#@}" == *@* ]]; then
    name="${entry%@*}"
    pin="${entry##*@}"
  fi
  desired_names+=("$name")
  desired_pins+=("$pin")
done

# Get currently installed global packages
yarn_global_dir=$(yarn global dir 2>/dev/null || true)
installed_pkgs=()
if [[ -n "$yarn_global_dir" && -f "$yarn_global_dir/package.json" ]]; then
  while IFS= read -r pkg || [[ -n "$pkg" ]]; do
    [[ -z "$pkg" ]] && continue
    installed_pkgs+=("$pkg")
  done < <(jq -r '.dependencies // {} | keys[]' "$yarn_global_dir/package.json" 2>/dev/null || true)
fi

# Install a missing yarn package.
#
# ex: install_yarn_pkg pkg_name [version_pin]
install_yarn_pkg() {
  local pkg=$1
  local pin=${2:-}
  local spec="$pkg@latest"
  [[ -n "$pin" ]] && spec="$pkg@$pin"

  echo "Installing yarn package: $spec"
  if ! yarn global add "$spec" &>/dev/null; then
    echo "Error: Failed to install yarn package $spec"
    return 1
  fi
  return 0
}

# Read the installed version of a global package (empty when absent).
installed_pkg_version() {
  local pkg=$1
  jq -r '.version // empty' "$yarn_global_dir/node_modules/$pkg/package.json" 2>/dev/null || true
}

# Install missing packages (and re-install pinned packages at the wrong version)
for i in "${!desired_names[@]}"; do
  pkg="${desired_names[$i]}"
  pin="${desired_pins[$i]}"
  is_installed=false
  for installed in "${installed_pkgs[@]:-}"; do
    if [[ "$installed" == "$pkg" ]]; then
      is_installed=true
      break
    fi
  done

  if [[ "$is_installed" == "false" ]]; then
    install_yarn_pkg "$pkg" "$pin"
  elif [[ -n "$pin" && "$(installed_pkg_version "$pkg")" != "$pin" ]]; then
    echo "Re-pinning yarn package $pkg to $pin (installed: $(installed_pkg_version "$pkg"))"
    install_yarn_pkg "$pkg" "$pin"
  else
    echo "yarn package $pkg is already installed"
  fi
done

# Uninstall packages that are not in the desired list
for pkg in "${installed_pkgs[@]:-}"; do
  # Skip if empty (defensive guard for malformed metadata)
  [[ -z "$pkg" ]] && continue

  is_desired=false
  for desired in "${desired_names[@]}"; do
    if [[ "$desired" == "$pkg" ]]; then
      is_desired=true
      break
    fi
  done

  if [[ "$is_desired" == "false" ]]; then
    echo "Uninstalling yarn package: $pkg"
    if ! yarn global remove "$pkg" &>/dev/null; then
      echo "Error: Failed to uninstall yarn package $pkg"
    fi
  fi
done

# Upgrade only unpinned packages; pinned entries stay at their exact version.
echo "Upgrading unpinned global yarn packages to latest"
for i in "${!desired_names[@]}"; do
  [[ -n "${desired_pins[$i]}" ]] && continue
  if ! yarn global upgrade "${desired_names[$i]}" --latest &>/dev/null; then
    echo "Error: Failed to upgrade global yarn package ${desired_names[$i]} to latest"
    exit 1
  fi
done

echo "All yarn packages synced successfully"
