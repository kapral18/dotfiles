#!/usr/bin/env python3
# Description: Save, list, and show cross-harness session handoff notes per repo.
"""Plain-file session handoffs that any agent harness can read and write.

Notes live in `$AGENT_HANDOFF_DIR` (default `~/.local/share/agent-handoffs`) as
`<repo>/<topic>.md`. `<repo>` is the basename of the main checkout, so every
worktree of a repo shares one namespace; outside git it is `global`.
Saving keeps the previous version as `<topic>.prev.md`.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

TOPIC_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
SOFT_LIMIT = 4096


def root_dir() -> Path:
    override = os.environ.get("AGENT_HANDOFF_DIR")
    return Path(override) if override else Path.home() / ".local/share/agent-handoffs"


def detect_repo() -> str:
    try:
        common = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return "global"
    path = Path(common)
    # A main checkout's common dir is `<repo>/.git`; a bare repo's is the repo itself.
    return (path.parent if path.name == ".git" else path).name or "global"


def checked(value: str, what: str) -> str:
    if not TOPIC_RE.match(value):
        raise SystemExit(f",handoff: invalid {what} {value!r}; use lowercase letters, digits, '.', '_', '-'")
    return value


def repo_dir(args: argparse.Namespace) -> Path:
    repo = args.repo if args.repo else detect_repo()
    slug = re.sub(r"[^a-z0-9._-]+", "-", repo.lower()).strip("-.") or "global"
    return root_dir() / checked(slug[:64], "repo")


def cmd_save(args: argparse.Namespace) -> int:
    body = sys.stdin.read()
    if not body.strip():
        raise SystemExit(",handoff: empty note on stdin; nothing saved")
    directory = repo_dir(args)
    directory.mkdir(parents=True, exist_ok=True)
    target = directory / f"{checked(args.topic, 'topic')}.md"
    if target.exists():
        os.replace(target, directory / f"{args.topic}.prev.md")
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=f".{args.topic}.")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(body if body.endswith("\n") else body + "\n")
    os.replace(tmp, target)
    size = target.stat().st_size
    if size > SOFT_LIMIT:
        print(f",handoff: note is {size} bytes; keep it under {SOFT_LIMIT}", file=sys.stderr)
    print(target)
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    suffix = ".prev.md" if args.prev else ".md"
    target = repo_dir(args) / f"{checked(args.topic, 'topic')}{suffix}"
    if not target.is_file():
        raise SystemExit(f",handoff: no note at {target}")
    sys.stdout.write(target.read_text(encoding="utf-8"))
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    dirs = sorted(p for p in root_dir().glob("*") if p.is_dir()) if args.all else [repo_dir(args)]
    notes = [note for directory in dirs for note in directory.glob("*.md") if not note.name.endswith(".prev.md")]
    for note in sorted(notes, key=lambda p: p.stat().st_mtime, reverse=True):
        stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(note.stat().st_mtime))
        label = f"{note.parent.name}/{note.stem}" if args.all else note.stem
        print(f"{stamp}  {label}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=",handoff", description=__doc__.splitlines()[0])
    parser.add_argument("--repo", help="repo namespace (default: current git repo, else 'global')")
    sub = parser.add_subparsers(dest="command", required=True)
    save = sub.add_parser("save", help="save the note on stdin as <topic>")
    save.add_argument("topic")
    save.set_defaults(func=cmd_save)
    show = sub.add_parser("show", help="print the note for <topic>")
    show.add_argument("topic")
    show.add_argument("--prev", action="store_true", help="print the previous version")
    show.set_defaults(func=cmd_show)
    listing = sub.add_parser("list", help="list notes, newest first")
    listing.add_argument("--all", action="store_true", help="list notes across every repo")
    listing.set_defaults(func=cmd_list)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
