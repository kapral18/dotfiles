#!/usr/bin/env bash
# Description: Run tele with an optional pass-backed Telegram app key.

set -euo pipefail

readonly PASS_APP_ID_PATH="telegram/apps/tuilegram/app_id"
readonly PASS_API_HASH_PATH="telegram/apps/tuilegram/api_hash"
# tele's default config path; it does not follow XDG_CONFIG_HOME.
readonly TELE_DEFAULT_CONFIG_FILE="$HOME/.config/tele/config.yml"

usage() {
  cat <<'EOF'
Usage: ,tg [tele args...]

Runs tele with the given args.
If pass entries telegram/apps/tuilegram/app_id and api_hash exist, first sets
telegram.api_id and telegram.api_hash in the config file tele will read:
the -config/--config value, or ~/.config/tele/config.yml.
Other settings and comments in that file stay; yq may normalize blank lines.

Examples:
  ,tg
  ,tg -e          # tele debug logging
  ,tg --version
Run "tele -h" for tele flags.
EOF
}

read_pass_value_if_exists() {
  local key="$1"
  if ! command -v pass >/dev/null 2>&1; then
    return 1
  fi
  pass show "$key" 2>/dev/null | awk 'NR==1{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); if (length($0)) print; exit}'
}

# Print the config path tele reads for these args. Mirrors Go flag parsing:
# flags end at "--" or the first non-flag arg; tele expands a leading "~/".
tele_config_path() {
  local path="$TELE_DEFAULT_CONFIG_FILE"
  while [ "$#" -gt 0 ]; do
    case "$1" in
    --) break ;;
    -config=* | --config=*) path="${1#*=}" ;;
    -config | --config)
      [ "$#" -ge 2 ] || break
      path="$2"
      shift
      ;;
    -?*) ;;
    *) break ;;
    esac
    shift
  done
  # shellcheck disable=SC2088 # match a literal "~/" prefix, as tele does
  if [[ "$path" == "~/"* ]]; then
    path="$HOME/${path#\~/}"
  fi
  printf '%s\n' "$path"
}

set_app_key() {
  local config_file="$1"
  local app_id="$2"
  local api_hash="$3"

  if ! [[ "$app_id" =~ ^[0-9]+$ ]]; then
    echo "pass entry $PASS_APP_ID_PATH is not a number" >&2
    return 1
  fi
  if ! command -v yq >/dev/null 2>&1; then
    echo "yq not found; it is needed to set the app key in $config_file" >&2
    return 1
  fi

  if [ ! -f "$config_file" ]; then
    # tele writes its full default config, then exits after the theme report.
    tele -config "$config_file" -theme-check >/dev/null
  fi

  local current_id current_hash
  current_id="$(yq '.telegram.api_id // ""' "$config_file")"
  current_hash="$(yq '.telegram.api_hash // ""' "$config_file")"
  if [ "$current_id" = "$app_id" ] && [ "$current_hash" = "$api_hash" ]; then
    return 0
  fi

  TG_APP_ID="$app_id" TG_API_HASH="$api_hash" \
    yq -i '.telegram.api_id = env(TG_APP_ID) | .telegram.api_hash = strenv(TG_API_HASH)' "$config_file"
  chmod 600 "$config_file"
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

app_id="$(read_pass_value_if_exists "$PASS_APP_ID_PATH" || true)"
api_hash="$(read_pass_value_if_exists "$PASS_API_HASH_PATH" || true)"

if [ -n "$app_id" ] && [ -n "$api_hash" ]; then
  set_app_key "$(tele_config_path "$@")" "$app_id" "$api_hash"
fi

exec tele "$@"
