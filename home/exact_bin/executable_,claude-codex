#!/usr/bin/env bash
# Description: Launch Claude Code through the current Codex ChatGPT subscription.

set -euo pipefail

adapter="$HOME/lib/,codex-adapter/main.py"
if [[ ! -f "$adapter" ]]; then
  echo "Error: Codex adapter not found at $adapter. Run chezmoi apply --no-tty ~/lib/,codex-adapter." >&2
  exit 127
fi

unset AGENT_BAND_MODEL_OVERRIDE AGENT_BAND_EFFORT_OVERRIDE AGENT_BAND_MODEL_FORMAT
export AGENT_BAND_SCHEMA_HARNESS="codex"
exec python3 "$adapter" claude "$@"
