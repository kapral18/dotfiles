#!/usr/bin/env python3
"""Format recognized AI Markdown conservatively; leave other files unchanged.

Usage: ,format-md [--check] FILES...

AI prose keeps existing sentence boundaries. Only plain mid-sentence
continuations that fit the soft 140-character boundary are joined.
Long lines split at sentence or strong clause boundaries when possible.
Ambiguous markup retains its existing lines; the boundary is not a hard cap.
AI paths include shared references, GitHub instructions, managed skills,
agent profiles, and the Cursor SOP plugin rule.

Options:
  --check   Report AI Markdown needing formatting without modifying files (exit 1).
"""

import re
import sys

AI_ENTRYPOINT_NAMES = {
    "AGENTS.md",
    "CLAUDE.md",
    "SKILL.md",
    "copilot-instructions.md",
    "readonly_AGENTS.md",
    "readonly_CLAUDE.md",
    "readonly_SKILL.md",
    "readonly_copilot-instructions.md",
}
AI_INSTRUCTION_PATH_MARKERS = (
    "/exact_agents/",
    "/exact_skills/",
    "/exact_hooks/",
    "/exact_references/",
    "/.agents/skills/",
    "/.agents/hooks/",
    "/.agents/references/",
    "/.github/instructions/",
    "/.claude/skills/",
    "/.claude/agents/",
    "/.codex/skills/",
    "/.cursor/skills/",
    "/.cursor/skills-cursor/",
    "/.cursor/agents/",
    "/.cursor/plugins/local/k-sop/rules/",
    "/.copilot/skills/",
    "/.copilot/agents/",
    "/.gemini/config/skills/",
    "/.omp/agent/skills/",
    "/.omp/agent/agents/",
    "/.pi/agent/agents/",
    "/.config/opencode/skills/",
)

# List markers (bullet, numeric, outline-letter) may appear at any indentation
# depth — CommonMark nests relative to the parent item's content column, not
# absolute 0-3 spaces. Letter markers (a., b., A), etc.) are not CommonMark
# ordered list markers, but are commonly used as outline sub-items that the
# author intends to keep on their own lines; treat them as structural so the
# unwrap pass does not concatenate them into the parent.
STRUCTURAL = re.compile(
    r"^("
    r"\s{0,3}#{1,6}\s"
    r"|\s*[-*+]\s"
    r"|\s*\d+[.)]\s"
    r"|\s*[a-zA-Z][.)]\s"
    r"|\s{0,3}>"
    r"|\s{0,3}```"
    r"|\s{0,3}~~~"
    r"|\s{0,3}---"
    r"|\s{0,3}\*\*\*"
    r"|\s{0,3}___"
    r"|\s{0,3}=+\s*$"
    r"|\s{0,3}<[a-zA-Z/]"
    r"|\s{0,3}\|"
    r")"
)

LIST_ITEM = re.compile(r"^(\s*(?:[-*+]\s+|\d+[.)]\s+|[a-zA-Z][.)]\s+))(.*)$")
SENTENCE_START = re.compile(r"[A-Z0-9`\"'(\[*_]")
SENTENCE_CLOSERS = set("\"')]}*_")
ABBREVIATIONS = {
    "e.g.",
    "i.e.",
    "etc.",
    "vs.",
    "mr.",
    "mrs.",
    "ms.",
    "dr.",
    "prof.",
    "sr.",
    "jr.",
    "st.",
    "no.",
}
AI_SOFT_LINE_BOUNDARY = 140


def is_structural(line):
    return bool(STRUCTURAL.match(line))


def is_blank(line):
    return line.strip() == ""


def preserves_hard_wraps(path):
    normalized = path.replace("\\", "/")
    filename = normalized.rsplit("/", 1)[-1]
    logical_filename = re.sub(r"^\.conform\.\d+\.", "", filename)
    if logical_filename in AI_ENTRYPOINT_NAMES:
        return True
    normalized = f"/{normalized.lstrip('/')}"
    return logical_filename.endswith(".md") and any(marker in normalized for marker in AI_INSTRUCTION_PATH_MARKERS)


def is_prose_list_item(line):
    return bool(LIST_ITEM.match(line))


def is_non_prose_structural(line):
    return is_structural(line) and not is_prose_list_item(line)


def token_before(text, index):
    start = index
    while start > 0 and not text[start - 1].isspace():
        start -= 1
    return text[start : index + 1].strip("`\"'([{*_").lower()


def should_split_sentence(text, punct_index, split_index):
    if text[punct_index] == "." and token_before(text, punct_index) in ABBREVIATIONS:
        return False
    if split_index >= len(text) or not text[split_index].isspace():
        return False
    next_index = split_index
    while next_index < len(text) and text[next_index].isspace():
        next_index += 1
    return next_index < len(text) and bool(SENTENCE_START.match(text[next_index]))


def split_sentences(text):
    text = re.sub(r"\s+", " ", text).strip()
    if not text:
        return []

    parts = []
    start = 0
    i = 0
    while i < len(text):
        if text[i] not in ".!?":
            i += 1
            continue

        split_index = i + 1
        while split_index < len(text) and text[split_index] in SENTENCE_CLOSERS:
            split_index += 1

        if should_split_sentence(text, i, split_index):
            parts.append(text[start:split_index].strip())
            start = split_index
            while start < len(text) and text[start].isspace():
                start += 1
            i = start
            continue

        i += 1

    parts.append(text[start:].strip())
    return [part for part in parts if part]


def sentence_boundary_lines(text, prefix="", continuation_prefix="", max_width=AI_SOFT_LINE_BOUNDARY):
    sentences = split_sentences(text)
    if not sentences:
        return [prefix.rstrip()] if prefix else []

    out = []
    current = ""

    def line_prefix():
        return prefix if not out else continuation_prefix

    def available_width():
        return max(20, max_width - len(line_prefix()))

    def flush_current():
        nonlocal current
        if current:
            out.append(line_prefix() + current)
            current = ""

    for sentence in sentences:
        candidate = sentence if not current else f"{current} {sentence}"
        if current and len(line_prefix() + candidate) > max_width:
            flush_current()
            current = ""
        elif current:
            current = candidate
            continue

        if len(line_prefix() + sentence) > max_width:
            chunks = wrap_long_sentence(sentence, available_width(), max(20, max_width - len(continuation_prefix)))
            for chunk in chunks[:-1]:
                out.append(line_prefix() + chunk)
            current = chunks[-1] if chunks else ""
        else:
            current = sentence
    if current:
        flush_current()
    return out


def conservative_prose_lines(raw_lines, prefix, continuation_prefix):
    # Preserve ambiguous markup instead of guessing where its prose begins.
    code_indent = len(continuation_prefix) + 4
    if any(
        re.search(r"[`\[\]<>|]|\w+://", line)
        or line.endswith(("  ", "\\"))
        or "\t" in line
        or len(line) - len(line.lstrip(" ")) >= code_indent
        for line in raw_lines
    ):
        return raw_lines

    out = []
    current = raw_lines[0]
    for line in raw_lines[1:]:
        candidate = current.rstrip() + " " + line.strip()
        # Punctuation at an authored line end is a boundary, even when an
        # abbreviation or a lowercase next line makes sentence detection unsure.
        boundary = re.search(r"[.!?;:—–][\"')\]}*_]*$", current.rstrip())
        indent = line[: len(line) - len(line.lstrip(" "))]
        if not boundary and indent == continuation_prefix and len(candidate) <= AI_SOFT_LINE_BOUNDARY:
            current = candidate
        else:
            out.extend(sentence_boundary_lines(current[len(prefix) :], prefix, continuation_prefix))
            prefix = indent
            current = line
    out.extend(sentence_boundary_lines(current[len(prefix) :], prefix, continuation_prefix))
    return out


def inside_inline_code(text, index):
    return text[:index].count("`") % 2 == 1


def find_clause_break(text, width):
    limit = min(len(text), width)
    lower = min(limit, max(40, int(width * 0.55)))
    semantic = []

    for i in range(1, limit + 1):
        if inside_inline_code(text, i):
            continue
        ch = text[i - 1]
        next_is_space = i >= len(text) or text[i].isspace()
        if next_is_space and ch in ";:—–":
            semantic.append(i)

    semantic = [pos for pos in semantic if pos >= lower and text[:pos].strip()]
    if semantic:
        return max(semantic)
    return None


def wrap_long_sentence(sentence, first_width, continuation_width):
    remaining = sentence.strip()
    chunks = []
    width = first_width

    while remaining:
        if len(remaining) <= width:
            chunks.append(remaining)
            break

        break_at = find_clause_break(remaining, width)
        if break_at is None:
            chunks.append(remaining)
            break

        chunk = remaining[:break_at].strip()
        if not chunk:
            chunks.append(remaining)
            break

        chunks.append(chunk)
        remaining = remaining[break_at:].strip()
        width = continuation_width

    return chunks


def normalize_ai_instruction_wraps(text):
    lines = text.split("\n")
    out = []
    code_fence = None
    in_frontmatter = False

    i = 0
    while i < len(lines):
        line = lines[i]
        stripped = line.rstrip()

        # Preserve YAML frontmatter verbatim; routing metadata is data, not prose.
        if i == 0 and stripped == "---":
            in_frontmatter = True
            out.append(line)
            i += 1
            continue
        if in_frontmatter:
            out.append(line)
            if stripped in ("---", "..."):
                in_frontmatter = False
            i += 1
            continue

        fence = re.match(r"\s*(`{3,}|~{3,})(.*)$", line)
        if code_fence:
            out.append(line)
            if fence and fence[1][0] == code_fence[0] and len(fence[1]) >= len(code_fence) and not fence[2].strip():
                code_fence = None
            i += 1
            continue
        if fence:
            code_fence = fence[1]
            out.append(line)
            i += 1
            continue

        if is_blank(stripped) or line.startswith(("    ", "\t")):
            out.append(line)
            i += 1
            continue

        if is_non_prose_structural(stripped):
            out.append(line)
            i += 1
            continue

        list_match = LIST_ITEM.match(stripped)
        if list_match:
            prefix, _ = list_match.groups()
            raw_lines = [line]
            i += 1
            while i < len(lines):
                candidate = lines[i]
                if is_blank(candidate) or is_structural(candidate):
                    break
                raw_lines.append(candidate)
                i += 1
            out.extend(conservative_prose_lines(raw_lines, prefix, " " * len(prefix)))
            continue

        prose_match = re.match(r"^(\s*)(.*)$", stripped)
        prose_prefix = prose_match.group(1)
        raw_lines = [line]
        i += 1
        while i < len(lines):
            candidate = lines[i]
            if is_blank(candidate) or is_structural(candidate):
                break
            raw_lines.append(candidate)
            i += 1
        if i < len(lines) and re.fullmatch(r" {0,3}(?:=+|-+)\s*", lines[i]):
            out.extend(raw_lines)
        else:
            out.extend(conservative_prose_lines(raw_lines, prose_prefix, prose_prefix))

    return "\n".join(out)


def unwrap(text, path=None):
    if path and preserves_hard_wraps(path):
        return normalize_ai_instruction_wraps(text)
    return text


def main():
    check_mode = "--check" in sys.argv
    paths = [a for a in sys.argv[1:] if a != "--check"]

    if not paths:
        print((__doc__ or "").strip(), file=sys.stderr)
        sys.exit(2)

    dirty = []
    for path in paths:
        with open(path) as f:
            original = f.read()
        result = unwrap(original, path)
        if result == original:
            continue
        if check_mode:
            dirty.append(path)
        else:
            with open(path, "w") as f:
                f.write(result)
            print(f"formatted: {path}")

    if check_mode and dirty:
        for p in dirty:
            print(f"  needs formatting: {p}")
        sys.exit(1)


if __name__ == "__main__":
    main()
