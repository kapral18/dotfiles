#:schema https://mise.jdx.dev/schema/mise.json

[settings]
activate_aggressive = true
idiomatic_version_file_enable_tools = ["node"]
trusted_config_paths = ["{{ .chezmoi.homeDir }}/code", "{{ .chezmoi.sourceDir | dir }}"]

[tools]
bun = "1.4.4"
go = "1.27.3"
java = "openjdk-21"
neovim = "0.12.6"
node = "26.13.0"
# Global pnpm tracks the latest release; a project pins its own via a local mise config.
pnpm = "12.18.0"
ruby = "4.0.9"
# rust-analyzer: Claude Code rust-analyzer-lsp plugin.
rust = { version = "1.99.1", components = "rust-analyzer" }
# @mise-bump-hold: Yarn Classic for projects still on yarn.
yarn = "1.22.22"
lua = ["5.1.5", "5.4.9"]
