{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/openai/gpt-5.2",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
  },
  "agent": {
    "plan": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "main": {
      "description": "Main workflow agent. Can invoke sub-agents as needed to accomplish independent tasks.",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.2",
      "reasoning_effort": "high",
    },
    "worker_a": {
      "description": "Implements tasks and reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.2",
      "reasoning_effort": "high",
    },
    "worker_b": {
      "description": "Second implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.2",
      "reasoning_effort": "high",
    },
    "worker_c": {
      "description": "Third implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.2",
      "reasoning_effort": "high",
    },
    "worker_d": {
      "description": "Fourth implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.2",
      "reasoning_effort": "high",
    },
  },
  "default_agent": "main",
  "mcp": "__MCP_SERVERS__",
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.2": {
          "options": {
            "reasoningEffort": "high",
          },
        },
      },
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "local": {
          "name": "Qwen3.6 35B A3B UD-Q4_K_XL (llama.cpp)",
        },
        "local-max": {
          "name": "Qwen3.6 35B A3B abliterated (llama.cpp)",
        },
      },
    },
  },
}
