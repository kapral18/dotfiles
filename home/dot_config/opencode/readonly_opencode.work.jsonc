{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
  },
  "agent": {
    "plan": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "main": {
      "description": "Main workflow agent. Can invoke sub-agents as needed to accomplish independent tasks.",
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
      "reasoning_effort": "max",
    },
    "worker_a": {
      "description": "Implements tasks and reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
      "reasoning_effort": "max",
    },
    "worker_b": {
      "description": "Second implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
      "reasoning_effort": "max",
    },
    "worker_c": {
      "description": "Third implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
      "reasoning_effort": "max",
    },
    "worker_d": {
      "description": "Fourth implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max",
      "reasoning_effort": "max",
    },
  },
  "default_agent": "main",
  "mcp": "__MCP_SERVERS__",
  "provider": {
    "openrouter": {
      "models": {
        // kimi lanes use only Fireworks, Together, and BaseTen, sorted by throughput under the $16/M cap via the
        // `kimi-lanes` preset (opencode has no request-body channel for this provider object).
        "moonshotai/kimi-k3@preset/kimi-lanes": {
          "options": {
            "reasoningEffort": "high",
          },
        },
        // deepseek lanes require FP8-or-higher quantization and sort OpenRouter providers by price via `deepseek-lanes-max`.
        "deepseek/deepseek-v4-flash-0731@preset/deepseek-lanes-max": {
          "options": {
            "reasoningEffort": "max",
          },
        },
        // glm lanes apply the same FP8-or-higher, price-sorted (24 t/s floor) policy to GLM-5.2 via `glm-lanes-max`.
        "z-ai/glm-5.2@preset/glm-lanes-max": {
          "options": {
            "reasoningEffort": "max",
          },
        },
      },
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "local": {
          "name": "Qwen3.6 35B A3B UD-Q4_K_XL (llama.cpp)",
        },
        "local-max": {
          "name": "Qwen3.6 35B A3B abliterated (llama.cpp)",
        },
        "nemotron-3.5": {
          "name": "NVIDIA Nemotron 3.5 Lightning 30B A3B Q4_K_M (llama.cpp)",
        },
      },
    },
  },
}
