{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
  "share": "disabled",
  "autoupdate": false,
  "subagent_depth": 1,
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
    "task": "deny",
  },
  "agent": {
    "plan": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "scout": {
      "disable": true,
    },
    "main": {
      "description": "Root workflow agent. Dispatch only ready implementation packets; own all stages and final verification.",
      "mode": "primary",
      "permission": { "task": { "*": "deny", "worker_*": "allow" } },
      "model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
      "reasoning_effort": "high",
    },
    "worker_a": {
      "description": "Implements tasks and reports concise results back to main agent",
      "mode": "subagent",
      "prompt": "{file:~/.config/tmux/agent_prompts/leaf-boundary.txt}",
      "permission": { "task": "deny" },
      "model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
      "reasoning_effort": "high",
    },
    "worker_b": {
      "description": "Second implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "prompt": "{file:~/.config/tmux/agent_prompts/leaf-boundary.txt}",
      "permission": { "task": "deny" },
      "model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
      "reasoning_effort": "high",
    },
    "worker_c": {
      "description": "Third implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "prompt": "{file:~/.config/tmux/agent_prompts/leaf-boundary.txt}",
      "permission": { "task": "deny" },
      "model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
      "reasoning_effort": "high",
    },
    "worker_d": {
      "description": "Fourth implementer for parallel work, reports concise results back to main agent",
      "mode": "subagent",
      "prompt": "{file:~/.config/tmux/agent_prompts/leaf-boundary.txt}",
      "permission": { "task": "deny" },
      "model": "openrouter/z-ai/glm-5.3-flash@preset/glm-lanes-high",
      "reasoning_effort": "high",
    },
  },
  "default_agent": "main",
  "mcp": "__MCP_SERVERS__",
  "provider": {
    "openrouter": {
      "models": {
        // kimi lanes use only Fireworks, Together, and BaseTen under the $16/M cap via the
        // `kimi-lanes` preset (opencode has no request-body channel for this provider object).
        "moonshotai/kimi-k3@preset/kimi-lanes": {
          "limit": { "context": 1048576, "output": 131072 },
          "options": {
            "reasoningEffort": "high",
          },
        },
        // glm lanes require FP8-or-higher quantization and a 24 t/s floor via `glm-lanes-high` (no sort: uptime-aware default LB);
        // the request model overrides the preset's pinned GLM-5.2 id (live-probed 2026-09-10), so GLM 5.3 Flash rides the same slug.
        "z-ai/glm-5.3-flash@preset/glm-lanes-high": {
          "limit": { "context": 1048576, "output": 131072 },
          "options": {
            "reasoningEffort": "high",
          },
        },
        // deepseek lanes carry a 35 t/s preferred floor under a $1.20/M completion cap (no quantization filter, no sort; presets re-versioned 2026-09-11)
        // on the still-selectable DeepSeek V4.1 Flash via `deepseek-lanes-max`.
        "deepseek/deepseek-v4.1-flash@preset/deepseek-lanes-max": {
          "limit": { "context": 1048576, "output": 384000 },
          "options": {
            "reasoningEffort": "max",
          },
        },
        // glm lanes apply the same FP8-or-higher, 24 t/s floor, no-sort policy to GLM-5.2 via `glm-lanes-max`.
        "z-ai/glm-5.2@preset/glm-lanes-max": {
          "limit": { "context": 1024000, "output": 128000 },
          "options": {
            "reasoningEffort": "max",
          },
        },
      },
    },
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "nemotron-3.5": {
          "name": "NVIDIA Nemotron 3.5 Lightning 30B A3B UD-Q4_K_XL (llama.cpp)",
          "limit": { "context": 262144, "output": 32000 },
        },
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B UD-Q4_K_XL (llama.cpp)",
          "limit": { "context": 262144, "output": 32000 },
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B UD-Q4_K_XL (llama.cpp)",
          "limit": { "context": 131072, "output": 32000 },
        },
        "qwen3.8-27b-instruct": {
          "name": "Qwen3.8 27B UD-Q4_K_XL instruct (llama.cpp)",
          "limit": { "context": 131072, "output": 32000 },
        },
      },
    },
  },
}
