fish_config theme choose Dracula

set -x fish_greeting

ulimit -Sn 2500000

set -x LANG en_US.UTF-8

if not set -q TERM
    set -gx TERM xterm-256color
end

set -x EDITOR nvim
set -x VISUAL nvim

set -x HOMEBREW_NO_AUTO_UPDATE 1
set -x HOMEBREW_PREFIX {{ .homebrewPrefix }}
set -x HOMEBREW_CELLAR {{ .homebrewPrefix }}/Cellar
set -x HOMEBREW_REPOSITORY {{ .homebrewPrefix }}
set -x MANPATH {{ .homebrewPrefix }}/share/man $MANPATH
set -x INFOPATH {{ .homebrewPrefix }}/share/info $INFOPATH

set -x SSH_AUTH_SOCK "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

{{ if eq .chezmoi.arch "amd64" }}
set -x GPG_TTY (tty)
{{ end -}}

set -x XDG_DATA_DIRS /usr/share /usr/local/share
set -x XDG_CONFIG_DIRS /etc/xdg

set -x XDG_CONFIG_HOME $HOME/.config
set -x XDG_CACHE_HOME $HOME/.cache
set -x XDG_DATA_HOME $HOME/.local/share
set -x XDG_DESKTOP_DIR $HOME/Desktop
set -x XDG_DOCUMENTS_DIR $HOME/Documents
set -x XDG_DOWNLOAD_DIR $HOME/Downloads
set -x XDG_MUSIC_DIR $HOME/Music
set -x XDG_PICTURES_DIR $HOME/Pictures
set -x XDG_VIDEOS_DIR $HOME/Videos

set -x LESS_TERMCAP_mb \e'[01;31m' # begin blinking
set -x LESS_TERMCAP_md \e'[01;38;5;74m' # begin bold
set -x LESS_TERMCAP_me \e'[0m' # end mode
set -x LESS_TERMCAP_se \e'[0m' # end standout-mode
set -x LESS_TERMCAP_so \e'[01;33m' # begin standout-mode - info box
set -x LESS_TERMCAP_ue \e'[0m' # end underline
set -x LESS_TERMCAP_us \e'[04;38;5;146m' # begin underline

if status --is-login
    fish_add_path -m -g {{ .homebrewPrefix }}/opt/coreutils/libexec/gnubin
    fish_add_path -m -g {{ .homebrewPrefix }}/bin
    fish_add_path -m -g {{ .homebrewPrefix }}/sbin

    fish_add_path -m -g "$HOME"/.local/share/pnpm/bin
    fish_add_path -m -g "$HOME"/.local/bin
    fish_add_path -m -g "$HOME"/bin

end

set -x FD_DEFAULT_OPTS "--hidden --follow --ignore-file $HOME/.config/ignore-globs"

set -x FZF_DEFAULT_OPTS "
    --no-mouse
    --height 80%
    --reverse
    --multi
    --info=inline
    --preview-window='right:60%:nowrap'
    --bind=ctrl-d:preview-down,ctrl-u:preview-up,ctrl-b:page-up,ctrl-f:page-down
"

set -x FZF_DEFAULT_COMMAND "git ls-files --cached --others --exclude-standard 2>/dev/null || fd --type f --type l"
set -x FZF_CTRL_T_COMMAND "$FZF_DEFAULT_COMMAND"
set -x FZF_ALT_C_COMMAND "fd --type d"

if type -q pass; and test -d ~/.password-store; and test -z "$GEMINI_API_KEY"
    set -gx GEMINI_API_KEY (pass google/gemini/api/token)
end

if test -z "$NANOBANANA_API_KEY"; and test -n "$GEMINI_API_KEY"
    set -gx NANOBANANA_API_KEY $GEMINI_API_KEY
end

# Do not export GOOGLE_CLOUD_PROJECT / GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_LOCATION here.
# Those steer Gemini Developer API clients onto Vertex.

if type -q pass; and test -d ~/.password-store; and test -z "$OPENROUTER_API_KEY"
    set -gx OPENROUTER_API_KEY (pass openrouter/api/token)
end

# Pi and OMP both ship a built-in `nvidia` provider (integrate.api.nvidia.com) that reads this
# variable. Stays unset when the active password store has no NIM entry.
if type -q pass; and test -d ~/.password-store; and test -z "$NVIDIA_API_KEY"
    set -l nvidia_nim_token (pass nvidia/nim/api/token 2>/dev/null)
    and set -gx NVIDIA_API_KEY $nvidia_nim_token
end

# Pi's built-in `typesafe` provider serves the Jev classifier (`typesafe/jev-latest`) to codemode
# scripts. Stays unset when the active password store has no TypeSafe entry.
if type -q pass; and test -d ~/.password-store; and test -z "$TYPESAFE_API_KEY"
    set -l typesafe_token (pass typesafe-jev/api/token 2>/dev/null)
    and set -gx TYPESAFE_API_KEY $typesafe_token
end

if status --is-interactive
    if type -q mise
        mise activate --shims fish | source
    end

    alias cat=bat
    alias c=chezmoi
    function codex --wraps codex --description "Launch Codex CLI through the managed ,codex wrapper"
        command ,codex $argv
    end
    alias fzfi='git ls-files --cached --others --exclude-standard 2>/dev/null || fd --type f --type l'
    function g --wraps git --description 'git with fsmonitor auto-recovery'
        command git $argv
        set -l git_status $status
        # Retry only read-only commands, and only when a configured fsmonitor daemon is down.
        if test $git_status -ne 0
            and contains -- "$argv[1]" status log show ls-files rev-parse
            and test "$(command git config --bool core.fsmonitor 2>/dev/null)" = true
            and not command git fsmonitor--daemon status >/dev/null 2>&1
            command git fsmonitor--daemon stop 2>/dev/null
            command git fsmonitor--daemon start 2>/dev/null
            command git $argv
            return $status
        end
        return $git_status
    end
    alias t=herdr
    alias tree='tree -I ".git|node_modules"'
    alias v=nvim
    alias vm="env NVIM_MUSIC=1 nvim"
    alias wt="git worktree"
    alias dash="gh dash"

    if type -q lsd
        alias ls='lsd -A'
        alias l='lsd -lAh'
        alias ll='lsd -lAtrh'
        alias la='lsd -A'
    else
        alias ls='ls -A'
        alias l='ls -lAh'
        alias ll='ls -lAtrh'
        alias la='ls -A'
    end

    alias reload_gpg='pkill -9 gpg-agent'

    if type -q starship
        starship init fish | source
    end

    if type -q zoxide
        zoxide init fish | source
    end

    if type -q navi
        navi widget fish | source
    end

end

set -l unique_paths
for dir in $PATH
    if not contains $dir $unique_paths
        set unique_paths $unique_paths $dir
    end
end
set -gx PATH $unique_paths

# Google Cloud SDK — static path instead of dynamic path.fish.inc (~150ms saved)
fish_add_path -gP /opt/homebrew/share/google-cloud-sdk/bin

# Machine-local extras (not in git). Missing file is a no-op.
# Sourced last so the extra file can override managed settings. fish conf.d/ runs too early for that.
if test -f $HOME/.config/fish/config.local.fish
    source $HOME/.config/fish/config.local.fish
end
