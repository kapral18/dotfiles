#:schema https://www.schemastore.org/chezmoi.json

{{ output "/bin/sh" "-c" `[ "$CHEZMOI_COMMAND" = init ] || exit 0; if { true < /dev/tty; } 2> /dev/null; then exec /bin/bash "$1" < /dev/tty >&2; fi; exec /bin/bash "$1" >&2` "sh" (joinPath .chezmoi.sourceDir ".bootstrap.sh") -}}

[data]
primaryEmail = {{ promptStringOnce . "primaryEmail" "Enter your primary email*: " | quote }}
primaryPublicSshKey = {{ promptStringOnce . "primaryPublicSshKey" "Enter your primary public SSH key*: " | quote }}
pgpCacheTtl = {{ promptStringOnce . "pgpCacheTtl" "Select Cache TTL for PGP config in sec:" "86400" | quote }}

{{ $homebrewPrefix := "/opt/homebrew" -}}
{{ if eq .chezmoi.arch "amd64" }}{{ $homebrewPrefix = "/usr/local" }}{{ end -}}
homebrewPrefix = {{ $homebrewPrefix | quote }}

{{/* Opt-in gate for the llama.cpp model sync hook (run_onchange_after_07-sync-llama-cpp-models).
     Default is false so `chezmoi apply` never auto-downloads multi-GB model weights.
     Set once per machine; re-prompt by clearing the value from ~/.config/chezmoi/chezmoi.toml. */ -}}
downloadLlamaCppModels = {{ promptBoolOnce . "downloadLlamaCppModels" "Download llama.cpp models on apply? y/N" false }}

[scriptEnv]
PATH = {{ printf "%s/.local/bin:%s/bin:%s/sbin:%s" .chezmoi.homeDir $homebrewPrefix $homebrewPrefix (env "PATH") | splitList ":" | uniq | join ":" | quote }}

