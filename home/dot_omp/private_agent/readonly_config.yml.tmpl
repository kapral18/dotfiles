# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
# {{ if eq .isWork true }}
# Work rides the Cursor backend (user call 2026-09-07): primaries on Fable 5.1
# at :high effort (Anthropic native provider; Fable 5+ exposes the five-tier
# low/medium/high/xhigh/max adaptive scale on the Messages API), smol on
# cursor/default (Cursor's "Auto" router id; reasoning off, so no :level
# suffix), advisor on gpt-6-astra via the openai-codex provider (same
# orchestrate-lane model/effort the codex harness rows use).
modelRoles:
  default: anthropic/claude-fable-5.1:high
  smol: cursor/default
  vision: anthropic/claude-fable-5.1:high
  slow: anthropic/claude-fable-5.1:high
  plan: anthropic/claude-fable-5.1:high
  task: anthropic/claude-fable-5.1:high
  advisor: openai-codex/gpt-6-astra:high

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - cursor
  - openai
# {{ else }}
# Personal rides the Codex backend (user call 2026-09-07): primaries on Fable 5.1
# at :high effort (Anthropic native provider; Fable 5+ exposes the five-tier
# low/medium/high/xhigh/max adaptive scale on the Messages API), smol on
# cursor/default (Cursor's "Auto" router id), advisor on gpt-6-astra via the
# openai-codex provider (same orchestrate-lane model/effort the codex harness rows use).
modelRoles:
  default: anthropic/claude-fable-5.1:high
  smol: cursor/default
  vision: anthropic/claude-fable-5.1:high
  slow: anthropic/claude-fable-5.1:high
  plan: anthropic/claude-fable-5.1:high
  task: anthropic/claude-fable-5.1:high
  advisor: openai-codex/gpt-6-astra:high

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - cursor
  - openai
# {{ end }}
# Advisor reviews primary turns and spawned agents using the profile's advisor role.
advisor:
  enabled: true
  subagents: true
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high

# omp installs via the unpinned yarn package in ~/.default-yarn-pkgs.
# Apply runs yarn global upgrade --latest. Startup update check stays off so
# yarn remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 2
  agentAdvisor:
    task: "on"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1 
