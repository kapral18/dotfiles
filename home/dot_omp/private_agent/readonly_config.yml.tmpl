# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
# {{ if eq .isWork true }}
# Work rides the Cursor backend (user call 2026-08-30): primaries on GPT-5.5 xhigh
# (the cursor harness category rows stay on gpt-5.6-sol-high only because the Task enum lacks gpt-5.5),
# smol on cursor/default (Cursor's "Auto" router id; reasoning off, so no :level suffix),
# advisor on Opus 5 High — the same refute lane the cursor harness rows use.
modelRoles:
  default: cursor/gpt-5.5:xhigh
  smol: cursor/default
  vision: cursor/gpt-5.5:xhigh
  slow: cursor/gpt-5.5:xhigh
  plan: cursor/gpt-5.5:xhigh
  task: cursor/gpt-5.5:xhigh
  advisor: cursor/claude-opus-5-high:high

modelProviderOrder:
  - openrouter
  - cursor
  - openai-codex
  - anthropic
  - openai
# {{ else }}
# Personal rides the Codex backend (user call 2026-08-30): primaries and advisor on GPT-5.5 xhigh
# (the openai-codex catalog is OpenAI-only, matching the codex harness rows; review/refute stay
# reduced_independence either way), smol on cursor/default (Cursor's "Auto" router id).
modelRoles:
  default: openai-codex/gpt-5.5:xhigh
  smol: cursor/default
  vision: openai-codex/gpt-5.5:xhigh
  slow: openai-codex/gpt-5.5:xhigh
  plan: openai-codex/gpt-5.5:xhigh
  task: openai-codex/gpt-5.5:xhigh
  advisor: openai-codex/gpt-5.5:xhigh

modelProviderOrder:
  - openrouter
  - cursor
  - openai-codex
  - anthropic
  - openai
# {{ end }}
# Advisor reviews primary turns and spawned agents using the profile's advisor role.
advisor:
  enabled: true
  subagents: true
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high

# omp installs via the unpinned yarn package in ~/.default-yarn-pkgs.
# Apply runs yarn global upgrade --latest. Startup update check stays off so
# yarn remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 2
  agentAdvisor:
    task: "on"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1 
