# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
#
# modelRoles is profile-independent: both machines ride the ChatGPT-subscription openai-codex
# provider for every role (user call 2026-09-23; was openrouter since 2026-09-07), so the block
# lives outside the isWork branch. Only the web-search chains below still fork on isWork.
#
# Every built-in omp role is pinned explicitly (default/smol/slow/vision/plan/commit/
# tiny/task/advisor/web per `omp config get modelRoles`); nothing falls through to the
# harness default or the @smol fallback. The root uses GPT-6.1 Sol :high (user call 2026-09-30:
# Sol/Luna only, no Astra). Research/review profiles use @default and inherit the active
# parent's model (normally Sol for a fresh root), rather than pinning a separate child model.
# - slow/plan: GPT-6.1 Sol :max; task (T2 implement): GPT-6.1 Sol :medium.
# - advisor: GPT-6.1 Sol :high; refute remains degraded in the same OpenAI family
#   as the primaries.
# - vision/smol: GPT-6 Luna :high; tiny/commit: GPT-6 Luna :medium.
modelRoles:
  default: openai-codex/gpt-6.1-sol:high
  smol: openai-codex/gpt-6-luna:high
  slow: openai-codex/gpt-6.1-sol:max
  vision: openai-codex/gpt-6-luna:high
  plan: openai-codex/gpt-6.1-sol:max
  commit: openai-codex/gpt-6-luna:medium
  tiny: openai-codex/gpt-6-luna:medium
  task: openai-codex/gpt-6.1-sol:medium
  advisor: openai-codex/gpt-6.1-sol:high
  web: openai-codex/gpt-6-luna

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - cursor
  - openai

# Background advisor is disabled; the refute role remains available for final verification. omp migrates
# `advisor.subagents` into `task.agentAdvisor.task` (settings.ts) and an explicit
# agentAdvisor entry wins, so both knobs are pinned off below.
advisor:
  enabled: false
  subagents: false
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high
extendedContext: true

# omp installs via the unpinned pnpm package in ~/.default-pnpm-pkgs.
# Apply runs pnpm update -g --latest. Startup update check stays off so
# pnpm remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

recap:
  enabled: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

# maxRecursionDepth 1: root may spawn; children get no `task` tool (user call
# 2026-09-07), making the SOP §3.7 leaf-worker boundary mechanical, not instruction-only.
# Explicit root async remains available. Implicit backgrounding also affects
# blocking children, so Bash/Eval must finish in the foreground by default.
async:
  enabled: true

bash:
  autoBackground:
    enabled: false
eval:
  autoBackground:
    enabled: false

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 1
  disabledAgents:
    - reviewer
    - security-reviewer
  agentAdvisor:
    task: "off"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - openrouter
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1
