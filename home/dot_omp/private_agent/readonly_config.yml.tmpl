# schema: https://raw.githubusercontent.com/opspec-io/omp/main/schema/config.schema.json
# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
modelRoles:
  default: anthropic/claude-opus-5-5:medium
  smol: anthropic/claude-sonnet-5-5:medium
  slow: anthropic/claude-opus-5-5:medium
  vision: anthropic/claude-sonnet-5-5:medium
  plan: anthropic/claude-opus-5-5:medium
  commit: anthropic/claude-haiku-5-5:medium
  tiny: anthropic/claude-haiku-5-5:medium
  task: anthropic/claude-sonnet-5-5:medium
  advisor: openai-codex/gpt-6-astra:xhigh
  web: anthropic/claude-haiku-5-5:medium

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - openai

# Enable the main advisor, but keep task advisors off. WATCHDOG.yml defines the advisor roster.
# Explicit task.agentAdvisor below takes precedence over migrated advisor.subagents.
advisor:
  enabled: true
  subagents: false
  # OMP's global enum takes strings only ("off", "1", "3", "5", "strict"); a bare number reads as "off".
  syncBacklog: "1"
  immuneTurns: 0

defaultThinkingLevel: medium
extendedContext: false

# Snapcompact first: it archives history locally as image frames (no model
# call); provider-native remote, then a soft summary, are fallbacks.
compaction:
  methodOrder: [snapcompact, remote, soft]

# omp installs via the unpinned pnpm package in ~/.default-pnpm-pkgs.
# Apply runs pnpm update -g --latest. Startup update check stays off so
# pnpm remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

recap:
  enabled: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

# maxRecursionDepth 1: root may spawn; children get no `task` tool.
# Explicit root async remains available. Implicit backgrounding also affects
# blocking children, so Bash/Eval must finish in the foreground by default.
async:
  enabled: true

bash:
  autoBackground:
    enabled: false
eval:
  autoBackground:
    enabled: false

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 1
  disabledAgents:
    - reviewer
    - security-reviewer
  agentAdvisor:
    task: "off"

retry:
  enabled: true
  maxRetries: 3

# ~/AGENTS.md §8 owns response tone and format, so OMP renders no personality block and no emoji-reaction invite.
personality: none
tui:
  reactions: false

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# OMP 18.11.1 migrates this legacy order into the web role's fallback chain.
# The explicit Haiku web role replaces the leading Codex selector; keyless
# scrapers follow, then OMP's hosted fallback. Keep Perplexity excluded:
# listing it would opt into OpenRouter sonar-pro.
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1
