# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
# {{ if eq .isWork true }}
modelRoles:
  default: openrouter/openai/gpt-5.5:xhigh
  smol: openrouter/deepseek/deepseek-v4-flash:xhigh
  vision: openrouter/openai/gpt-5.5:xhigh
  slow: openrouter/openai/gpt-5.5:xhigh
  plan: openrouter/openai/gpt-5.5:xhigh
  task: openrouter/openai/gpt-5.5:xhigh
  advisor: openrouter/anthropic/claude-sonnet-4.6:xhigh

modelProviderOrder:
  - openrouter
  - cursor
  - openai-codex
  - anthropic
  - openai
# {{ else }}
modelRoles:
  default: openrouter/openai/gpt-5.5:xhigh
  smol: openrouter/deepseek/deepseek-v4-flash:xhigh
  vision: openrouter/openai/gpt-5.5:xhigh
  slow: openrouter/openai/gpt-5.5:xhigh
  plan: openrouter/openai/gpt-5.5:xhigh
  task: openrouter/openai/gpt-5.5:xhigh
  advisor: openrouter/anthropic/claude-sonnet-4.6:xhigh

modelProviderOrder:
  - openrouter
  - cursor
  - openai-codex
  - anthropic
  - openai
# {{ end }}
# Advisor reviews primary turns and spawned agents using the profile's advisor role.
advisor:
  enabled: true
  subagents: true
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high

# omp installs via the unpinned yarn package in ~/.default-yarn-pkgs.
# Apply runs yarn global upgrade --latest. Startup update check stays off so
# yarn remains the installer.
startup:
  checkUpdate: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 2

retry:
  enabled: true
  maxRetries: 5

symbolPreset: nerd

theme:
  dark: titanium

setupVersion: 1

# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
