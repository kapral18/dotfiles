# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
#
# modelRoles is profile-independent, so the block lives outside the isWork branch.
# Only the web-search chains below still fork on isWork.
#
# Every built-in omp role is pinned explicitly (default/smol/slow/vision/plan/commit/
# tiny/task/advisor/web per `omp config get modelRoles`); nothing falls through to the
# harness default or the @smol fallback. Working roles use the Claude subscription
# (anthropic provider, user call 2026-10-10; was openai-codex since 2026-09-23).
# k-agent-reviewer uses @default.
# - default: Claude Opus 5.5 :high; slow/plan: Opus 5.5 :max; task: Opus 5.5 :medium
# - vision/smol: Claude Sonnet 5.5 :high; tiny/commit: Claude Haiku 5.5 :medium
# - advisor: GPT-6 Astra :high, a reviewer from another model family (user call 2026-10-09).
# - web: GPT-6 Luna, so web search keeps the Codex provider chain below.
modelRoles:
  default: anthropic/claude-opus-5-5:high
  smol: anthropic/claude-sonnet-5-5:high
  slow: anthropic/claude-opus-5-5:max
  vision: anthropic/claude-sonnet-5-5:high
  plan: anthropic/claude-opus-5-5:max
  commit: anthropic/claude-haiku-5-5:medium
  tiny: anthropic/claude-haiku-5-5:medium
  task: anthropic/claude-opus-5-5:medium
  advisor: openai-codex/gpt-6-astra:high
  web: openai-codex/gpt-6-luna

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - openai

# Enable the main advisor, but keep task advisors off. WATCHDOG.yml defines the advisor roster.
# Explicit task.agentAdvisor below takes precedence over migrated advisor.subagents.
advisor:
  enabled: true
  subagents: false
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high
extendedContext: true

# omp installs via the unpinned pnpm package in ~/.default-pnpm-pkgs.
# Apply runs pnpm update -g --latest. Startup update check stays off so
# pnpm remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

recap:
  enabled: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

# maxRecursionDepth 1: root may spawn; children get no `task` tool.
# Explicit root async remains available. Implicit backgrounding also affects
# blocking children, so Bash/Eval must finish in the foreground by default.
async:
  enabled: true

bash:
  autoBackground:
    enabled: false
eval:
  autoBackground:
    enabled: false

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 1
  disabledAgents:
    - reviewer
    - security-reviewer
  agentAdvisor:
    task: "off"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - openrouter
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1
