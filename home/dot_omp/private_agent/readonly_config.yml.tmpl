# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
#
# modelRoles is profile-independent (user call 2026-09-07): both machines ride the
# openrouter provider for every role, so the block lives outside the isWork branch.
# Only the web-search chains below still fork on isWork.
#
# Every built-in omp role is pinned explicitly (default/smol/slow/vision/plan/commit/
# tiny/task/advisor per `omp config get modelRoles`); nothing falls through to the
# harness default or the @smol fallback.
# - T1 primaries (default/vision/slow/plan): Muse Spark 1.3, :xhigh for default, :max for the
#   deliberate slow/plan lanes and :high for vision. research/review profiles ride @default.
# - task (T2 implement: the native `task` agent and every implement worker): GLM 5.3 at :high
#   (user call 2026-09-07; the orchestrator thinks, the implementer runs one tier below).
# - smol: GLM 5.3 Flash at :high. cursor/default rode the cursor-agent transport and every
#   @smol lane (bundled scout/sonic) died on Cursor's free-request limit.
# - tiny (titles, memory, auto-thinking classification, unexpected-stop detection):
#   GLM 5.3 Flash at :medium — background chores.
# - commit (commit-message generation): GLM 5.3 Flash at :medium.
# - advisor: grok-4.6 at :xhigh. A non-Anthropic, non-Z.ai counter family keeps the
#   advisor/review/refute lanes independent of the primaries.
modelRoles:
  default: openrouter/meta/muse-spark-1.3:xhigh
  smol: openrouter/z-ai/glm-5.3-flash:high
  slow: openrouter/meta/muse-spark-1.3:max
  vision: openrouter/meta/muse-spark-1.3:high
  plan: openrouter/meta/muse-spark-1.3:max
  commit: openrouter/z-ai/glm-5.3-flash:medium
  tiny: openrouter/z-ai/glm-5.3-flash:medium
  task: openrouter/z-ai/glm-5.3:high
  advisor: openrouter/x-ai/grok-4.6:xhigh

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - cursor
  - openai

# Background advisor is disabled; the refute role remains available for final verification. omp migrates
# `advisor.subagents` into `task.agentAdvisor.task` (settings.ts) and an explicit
# agentAdvisor entry wins, so both knobs are pinned off below.
advisor:
  enabled: false
  subagents: false
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high
extendedContext: true

# omp installs via the unpinned pnpm package in ~/.default-pnpm-pkgs.
# Apply runs pnpm update -g --latest. Startup update check stays off so
# pnpm remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

# maxRecursionDepth 1: root may spawn; children get no `task` tool (user call
# 2026-09-07), making the SOP §3.7 leaf-worker boundary mechanical, not instruction-only.
# Explicit root async remains available. Implicit backgrounding also affects
# blocking children, so Bash/Eval must finish in the foreground by default.
async:
  enabled: true

bash:
  autoBackground:
    enabled: false
eval:
  autoBackground:
    enabled: false

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 1
  disabledAgents:
    - reviewer
    - security-reviewer
  agentAdvisor:
    task: "off"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - openrouter
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1
