# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
#
# modelRoles is profile-independent (user call 2026-09-07): both machines ride the
# native anthropic provider for primaries and the native openai-codex provider for
# the advisor, so the block lives outside the isWork branch. Only the web-search
# chains below still fork on isWork.
#
# Every built-in omp role is pinned explicitly (default/smol/slow/vision/plan/commit/
# tiny/task/advisor per `omp config get modelRoles`); nothing falls through to the
# harness default or the @smol fallback.
# - T1 primaries (default/vision/slow/plan): Fable 5.1 at :high (Fable 5+ exposes the five-tier
#   low/medium/high/xhigh/max adaptive scale on the Messages API). research/review profiles ride @default.
# - task (T2 implement: the native `task` agent and every implement worker): Opus 5 at :high
#   (user call 2026-09-07; the orchestrator thinks, the implementer runs one tier below).
# - smol: Sonnet 5 at :high. cursor/default rode the cursor-agent transport and every
#   @smol lane (bundled scout/sonic) died on Cursor's free-request limit.
# - tiny (titles, memory, auto-thinking classification, unexpected-stop detection):
#   Sonnet 5 at :medium — background chores.
# - commit (commit-message generation): Sonnet 5 at :medium.
# - advisor: gpt-6-astra via openai-codex. Astra is absurdly expensive (user call 2026-09-07)
#   and is permitted only for advisor/review/refute; the codex harness itself now runs sol as T1.
modelRoles:
  default: anthropic/claude-fable-5.1:high
  smol: anthropic/claude-sonnet-5:high
  slow: anthropic/claude-fable-5.1:high
  vision: anthropic/claude-fable-5.1:high
  plan: anthropic/claude-fable-5.1:high
  commit: anthropic/claude-sonnet-5:medium
  tiny: anthropic/claude-sonnet-5:medium
  task: anthropic/claude-opus-5:high
  advisor: openai-codex/gpt-6-astra:high

modelProviderOrder:
  - anthropic
  - openai-codex
  - openrouter
  - cursor
  - openai

# Background advisor is disabled; the refute role remains available for final verification. omp migrates
# `advisor.subagents` into `task.agentAdvisor.task` (settings.ts) and an explicit
# agentAdvisor entry wins, so both knobs are pinned off below.
advisor:
  enabled: false
  subagents: false
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high

# omp installs via the unpinned yarn package in ~/.default-yarn-pkgs.
# Apply runs yarn global upgrade --latest. Startup update check stays off so
# yarn remains the installer.
startup:
  checkUpdate: false
  quiet: true
  showSplash: false

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

# maxRecursionDepth 1: root may spawn; children get no `task` tool (user call
# 2026-09-07), making the SOP §3.7 leaf-worker boundary mechanical, not instruction-only.
# Explicit root async remains available. Implicit backgrounding also affects
# blocking children, so Bash/Eval must finish in the foreground by default.
async:
  enabled: true

bash:
  autoBackground:
    enabled: false
eval:
  autoBackground:
    enabled: false

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 1
  disabledAgents:
    - reviewer
    - security-reviewer
  agentAdvisor:
    task: "off"

retry:
  enabled: true
  maxRetries: 3

symbolPreset: nerd

theme:
  dark: dark-catppuccin
setupVersion: 2
# web_search: unlisted ids stay in the fallback chain, so every unused provider
# is excluded. Listing perplexity is an OpenRouter sonar-pro opt-in. Keyless
# scrapers are duckduckgo/startpage/ecosia/google/mojeek/public. Personal keeps
# those after Codex in OMP's built-in relative order.
# {{ if eq .isWork true }}
providers:
  webSearchOrder:
    - codex
    - gemini
    - google
    - duckduckgo
  webSearchExclude:
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - ecosia
    - mojeek
    - public
# {{ else }}
providers:
  webSearchOrder:
    - codex
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
  webSearchExclude:
    - perplexity
    - gemini
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
# {{ end }}
composer:
  shape: rule
terminal:
  showProgress: true
display:
  cacheMissMarker: true
steeringMode: one-at-a-time
tools:
  approvalMode: yolo
  approval:
    {}
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
astGrep:
  enabled: true
generate_image:
  enabled: true
computer:
  enabled: true
checkpoint:
  enabled: true
github:
  enabled: true
grep:
  contextBefore: 1
