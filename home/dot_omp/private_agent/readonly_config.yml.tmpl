# Managed by chezmoi (source: home/dot_omp/private_agent/readonly_config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
# {{ if eq .isWork true }}
modelRoles:
  default: cursor/kimi-k3-high:high
  smol: cursor/composer-2.5:high
  vision: cursor/claude-sonnet-5-high:high
  slow: cursor/kimi-k3-high:high
  plan: cursor/kimi-k3-high:high
  task: cursor/kimi-k3-high:high
  advisor: cursor/kimi-k3-high:high

modelProviderOrder:
  - cursor
  - openrouter
  - openai-codex
  - anthropic
  - openai
# {{ else }}
modelRoles:
  default: cursor/kimi-k3-high:high
  smol: cursor/composer-2.5:high
  vision: cursor/claude-sonnet-5-high:high
  slow: cursor/kimi-k3-high:high
  plan: cursor/kimi-k3-high:high
  task: cursor/kimi-k3-high:high
  advisor: cursor/kimi-k3-high:high

modelProviderOrder:
  - cursor
  - openai-codex
  - openrouter
  - anthropic
  - openai
# {{ end }}
advisor:
  enabled: true
  subagents: true
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: high

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 2

retry:
  enabled: true
  maxRetries: 5

symbolPreset: nerd

theme:
  dark: titanium

setupVersion: 1

providers:
  webSearchOrder:
    - perplexity
    - gemini
    - anthropic
    - codex
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - duckduckgo
    - ecosia
    - google
    - mojeek
    - public
