# Managed by chezmoi (source: home/dot_omp/private_agent/config.yml.tmpl).
# Keep OMP native guidance/features as the base; this file only pins user policy.
{{ if eq .isWork true -}}
modelRoles:
  default: github-copilot/gpt-5.3-codex:high
  smol: github-copilot/claude-sonnet-5:medium
  slow: github-copilot/gpt-5.5:medium
  plan: github-copilot/gpt-5.5:medium
  advisor: github-copilot/gpt-5.5:medium

modelProviderOrder:
  - github-copilot
  - openrouter
  - anthropic
  - openai
{{ else -}}
modelRoles:
  default: openai-codex/gpt-5.5:medium
  smol: openai-codex/gpt-5.6-terra:medium
  slow: openai-codex/gpt-5.5:medium
  plan: openai-codex/gpt-5.5:medium
  advisor: openai-codex/gpt-5.5:medium

modelProviderOrder:
  - openai-codex
  - github-copilot
  - openrouter
  - anthropic
  - openai
{{ end -}}
advisor:
  enabled: true
  subagents: true
  syncBacklog: 1
  immuneTurns: 0

defaultThinkingLevel: medium

memory:
  backend: off

autolearn:
  enabled: false
  autoContinue: false

dev:
  autoqaConsent: granted

skills:
  enabled: true
  enableSkillCommands: true

task:
  isolation:
    mode: auto
  enableEffort: true
  enableLsp: true
  maxRecursionDepth: 2

retry:
  enabled: true
  maxRetries: 5

symbolPreset: nerd

theme:
  dark: titanium

setupVersion: 1
