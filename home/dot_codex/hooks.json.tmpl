{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'AI_EMBED_WARM=1 AGENT_HOOK_OUTPUT=hook_specific exec {{ .chezmoi.homeDir }}/.agents/hooks/session_context.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'AGENT_HOOK_OUTPUT=hook_specific exec {{ .chezmoi.homeDir }}/.agents/hooks/perturn_recall.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'AGENT_HOOK_OUTPUT=hook_specific exec {{ .chezmoi.homeDir }}/.agents/hooks/premise_nudge.py'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'AGENT_BAND_HARNESS=codex exec {{ .chezmoi.homeDir }}/.agents/hooks/band_gate.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'AGENT_HOOK_OUTPUT=hook_specific exec {{ .chezmoi.homeDir }}/.agents/hooks/premise_nudge.py'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.agents/hooks/worklog_dispatcher.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
