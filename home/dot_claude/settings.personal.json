{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "alwaysThinkingEnabled": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5[1m]",
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "disableClaudeAiConnectors": true,
  "agentPushNotifEnabled": true,
  "tui": "fullscreen",
  "modelSettings": {
    "claude-opus-5-5[1m]": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_EMBED_WARM=1 $HOME/.agents/hooks/session_context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_BAND_HARNESS=claude_code $HOME/.agents/hooks/band_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/premise_nudge.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/read_gate.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/publish_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/worklog_dispatcher.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/premise_nudge.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/read_gate.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/worklog_dispatcher.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/perturn_recall.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
