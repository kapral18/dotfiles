{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/stop-review:~/.claude/mods/intent-guard"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && \"$HOME/.local/share/mise/shims/bun\" \"$HOME/.claude/guards/guards.ts\"",
            "timeout": 40,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && \"$HOME/.local/share/mise/shims/bun\" \"$HOME/.claude/guards/guards.ts\"",
            "timeout": 40,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && \"$HOME/.local/share/mise/shims/bun\" \"$HOME/.claude/guards/guards.ts\"",
            "timeout": 40,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME\" && \"$HOME/.local/share/mise/shims/bun\" \"$HOME/.claude/guards/guards.ts\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5",
  "advisorModel": "opus",
  "effortLevel": "medium",
  "autoCompactWindow": 600000,
  "autoMemoryEnabled": false,
  "subagentPromptCacheTtl": "1h",
  "awaySummaryEnabled": false,
  "disableClaudeAiConnectors": true,
  "agentPushNotifEnabled": true,
  "tui": "fullscreen",
  "enabledPlugins": {
    "cc-plugin-diff@builtin": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 600000
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 1000000
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
