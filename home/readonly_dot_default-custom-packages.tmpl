# Custom package registry (rendered by chezmoi).
# Format (pipe-delimited):
# - dmg|App Name|owner/repo|release-tag|AppBundle.app|asset-pattern
# - dmg|App Name|https://.../app.dmg|latest|AppBundle.app|.dmg
# - tar_gz_bin|tool-name|owner/repo|release-tag|asset-pattern|bin-in-archive|output-binary-name
# - file|tool-name|owner/repo|release-tag|asset-pattern|output-binary-name
# - zip_opt|tool-name|owner/repo|release-tag|asset-pattern|bin-in-archive|output-binary-name
# Lines starting with `#` are ignored.

{{ $os := .chezmoi.os }}
{{ $arch := .chezmoi.arch }}

dmg|FluidVoice|altic-dev/FluidVoice|latest|FluidVoice.app|.dmg
dmg|Squirrel Disk|adileo/squirreldisk|latest|SquirrelDisk.app|.dmg
dmg|Jharu|riponcm/Jharu|latest|Jharu.app|.dmg

# mdtt
# https://github.com/szktkfm/mdtt
{{ $mdttTag := "v0.3.1" }}
{{ $mdttAsset := "" }}
{{ if eq $os "darwin" }}
  {{ if eq $arch "arm64" }}
    {{ $mdttAsset = "mdtt_Darwin_arm64.tar.gz" }}
  {{ else }}
    {{ $mdttAsset = "mdtt_Darwin_x86_64.tar.gz" }}
  {{ end }}
{{ else if eq $os "linux" }}
  {{ if eq $arch "arm64" }}
    {{ $mdttAsset = "mdtt_Linux_arm64.tar.gz" }}
  {{ else }}
    {{ $mdttAsset = "mdtt_Linux_x86_64.tar.gz" }}
  {{ end }}
{{ end }}
{{ if ne $mdttAsset "" }}
tar_gz_bin|mdtt|szktkfm/mdtt|{{ $mdttTag }}|{{ $mdttAsset }}|mdtt|mdtt
{{ end }}

# kitten (kitty CLI — used for image preview in fzf via unicode-placeholder protocol)
# https://github.com/kovidgoyal/kitty
{{ $kittenAsset := "" }}
{{ if eq $os "darwin" }}
  {{ if eq $arch "arm64" }}
    {{ $kittenAsset = "kitten-darwin-arm64" }}
  {{ else }}
    {{ $kittenAsset = "kitten-darwin-amd64" }}
  {{ end }}
{{ else if eq $os "linux" }}
  {{ if eq $arch "arm64" }}
    {{ $kittenAsset = "kitten-linux-arm64" }}
  {{ else }}
    {{ $kittenAsset = "kitten-linux-amd64" }}
  {{ end }}
{{ end }}
{{ if ne $kittenAsset "" }}
file|kitten|kovidgoyal/kitty|latest|{{ $kittenAsset }}|kitten
{{ end }}

# enola
# https://github.com/TheYahya/enola
{{ $enolaTag := "v0.4.0" }}
{{ $enolaAsset := "" }}
{{ if eq $os "darwin" }}
  {{ if eq $arch "arm64" }}
    {{ $enolaAsset = "enola_0.4.0_darwin_arm64.tar.gz" }}
  {{ else }}
    {{ $enolaAsset = "enola_0.4.0_darwin_amd64.tar.gz" }}
  {{ end }}
{{ else if eq $os "linux" }}
  {{ if eq $arch "arm64" }}
    {{ $enolaAsset = "enola_0.4.0_linux_arm64.tar.gz" }}
  {{ else }}
    {{ $enolaAsset = "enola_0.4.0_linux_amd64.tar.gz" }}
  {{ end }}
{{ end }}
{{ if ne $enolaAsset "" }}
tar_gz_bin|enola|TheYahya/enola|{{ $enolaTag }}|{{ $enolaAsset }}|enola|enola
{{ end }}

# sd-cli (stable-diffusion.cpp). Metal runner for ,image-local.
# Zip ships sd-cli + libstable-diffusion.dylib; zip_opt keeps the dylib beside the binary.
# https://github.com/leejet/stable-diffusion.cpp
{{ if eq $os "darwin" }}
zip_opt|sd-cli|leejet/stable-diffusion.cpp|master-820-de298c2|sd-*-bin-Darwin-macOS-*-arm64.zip|sd-cli|sd-cli
{{ end }}
