{{- /*
Resolve the model id an agent profile should carry from its category. Call with:
(dict "root" . "harness" "<category_models key>" "agent" "<agent_bindings key>").

The profile names only itself, agent_bindings selects the portable category, and category_models
decides what that category costs on this harness.
*/ -}}
{{- $root := .root -}}
{{- $category := index $root.agent_bindings .agent -}}
{{- $pick := index (index $root.category_models .harness) $category -}}
{{- $pick.model -}}
