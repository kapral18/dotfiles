# Library access to GnuPG
# https://www.gnupg.org/related_software/gpgme/
brew "gpgme"

# macOS pinentry dialog for GnuPG
# https://github.com/GPGTools/pinentry-mac
brew "pinentry-mac"

# Password manager
# https://www.passwordstore.org/
brew "pass"

# Stay updated on PRs from your terminal
# https://github.com/dhth/prs
tap "dhth/tap", trusted: true
brew "dhth/tap/prs"

# TDLib runtime (used by the local telegramtui fork build/runtime).
brew "tdlib", args: ["HEAD"]

# Java build tool for local telegramtui fork builds.
# https://maven.apache.org/
brew "maven"
