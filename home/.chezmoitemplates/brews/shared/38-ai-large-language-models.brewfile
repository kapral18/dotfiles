# AI code agent
# https://github.com/sst/opencode
brew "opencode"

# Google Antigravity terminal coding agent (`agy`)
# https://github.com/google-antigravity/antigravity-cli
cask "antigravity-cli"

# Google Antigravity desktop agent orchestration platform (`Antigravity.app`)
# https://antigravity.google/product/antigravity-2
cask "antigravity"

# OpenAI Codex desktop app (`Codex.app`); the cask is deprecated upstream and
# the Codex CLI can also install the app with `codex app`
# https://chatgpt.com/codex?app-landing-page=true
cask "codex-app"

# Anthropic Claude desktop app (`Claude.app`)
# https://claude.com/download
cask "claude"

# Terminal tool to right-size LLM models to your hardware (RAM, CPU, GPU)
# https://github.com/AlexsJones/llmfit
brew "llmfit"

# LLM inference in C/C++ with OpenAI/Anthropic-compatible llama-server
# https://github.com/ggml-org/llama.cpp
brew "llama.cpp"

# Official Hugging Face CLI (`hf`) — model downloads, auth, repo listing
# https://huggingface.co/docs/huggingface_hub/guides/cli
brew "hf"

# Terminal UI for code review — review AI-generated diffs like a GitHub PR,
# annotate with structured comments, export as LLM-ready markdown
# https://github.com/agavra/tuicr
tap "agavra/tap"
brew "agavra/tap/tuicr"
